---
import BaseLayout from "@/src/layouts/BaseLayout.astro"
import HomePage from "@/src/components/pages/home"
import { HeroVatCalc } from "@/src/components/hero-vat-calc"
---

<BaseLayout
  title="KRA VAT, eTIMS & iTax Help Kenya | Fix Today, SmartVAT"
  description="eTIMS invoice rejected? VAT return due? iTax portal down? Free diagnostic tools and KRA-registered agents. VAT registration KES 5,000. M-PESA accepted."
  path="/"
  keywords={[
    "eTIMS help Kenya",
    "VAT registration Kenya",
    "iTax not working",
    "eTIMS down",
    "eTIMS account locked",
    "VAT filing Kenya",
    "KRA VAT penalty",
    "VAT calculator Kenya",
    "eTIMS pending sync",
    "monthly VAT filing service",
  ]}
>
  {/* ─── HERO ─── Left: copy (static HTML, no JS). Right: working VAT calculator island. */}
  <section class="bg-canvas overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-12 pt-8 lg:pt-14 pb-12 lg:pb-20">
      <div class="grid lg:grid-cols-[1fr_1.08fr] gap-10 xl:gap-16 items-center">
        <!-- Copy column -->
        <div class="max-w-[620px]">
          <p class="font-mono text-[0.7rem] font-semibold text-blue-600 mb-5 inline-flex items-center gap-2">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
              <path d="M8 1.5 13.5 3.5v4c0 3.2-2.3 5.9-5.5 7-3.2-1.1-5.5-3.8-5.5-7v-4z"></path>
              <path d="m5.8 8 1.6 1.6 2.8-3"></path>
            </svg>
            Last verified 8 Aug 2026 against KRA guidance
          </p>

          <h1 class="font-display text-[clamp(2.6rem,4.8vw,4rem)] font-bold leading-[1.04] tracking-tight text-ink mb-3 max-w-[14ch] sm:max-w-none">
            Your eTIMS invoice failed.
            <span class="block text-brand">VAT return is due.</span>
          </h1>

          <p class="text-[1.08rem] lg:text-[1.15rem] font-semibold text-ink-soft leading-snug mb-4 max-w-[46ch]">
            Run the free error diagnostic — the fix in minutes, not days.
          </p>

          <p class="text-[0.92rem] leading-relaxed text-ink-soft/90 mb-7 max-w-[52ch]">
            <span class="font-semibold text-brand">Rejected invoices. Pending sync. Locked accounts.</span>{" "}
            Free diagnostic tools for every common KRA error — or a KRA-registered agent handles
            the paperwork while you get back to business.
          </p>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 mb-7">
            <a
              href="/tools/etims-diagnostic/"
              data-track="service-cta"
              data-cta-type="hero-etims-diagnostic"
              data-service="eTIMS Diagnostic"
              class="inline-flex w-full sm:w-auto flex-col items-center justify-center bg-brand hover:bg-brand-hover text-white px-7 py-3 rounded-lg shadow-[0_10px_24px_-10px_rgba(220,38,38,0.6)] transition-colors"
            >
              <span class="inline-flex items-center gap-2.5 font-semibold text-[0.95rem]">
                Fix My eTIMS Issue
                <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4"></path>
                </svg>
              </span>
              <span class="text-[0.68rem] text-white font-medium mt-0.5">
                Free diagnostic — exact fix steps in 2 minutes.
              </span>
            </a>
            <a
              href="/services/vat-registration/"
              data-track="service-cta"
              data-cta-type="hero-vat-registration"
              data-service="VAT Registration"
              class="inline-flex w-full sm:w-auto flex-col items-center justify-center border border-ink/70 text-ink hover:bg-canvas-warm px-7 py-3 rounded-lg transition-colors"
            >
              <span class="inline-flex items-center gap-2.5 font-semibold text-[0.95rem]">
                Register for VAT — KES 5,000
                <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4"></path>
                </svg>
              </span>
              <span class="text-[0.68rem] text-ink-muted font-medium mt-0.5">
                We handle the iTax work. 1–3 working days.
              </span>
            </a>
          </div>

          <div class="flex flex-wrap gap-x-6 gap-y-3">
            <div class="flex items-center gap-2 text-[0.85rem] font-medium text-ink-soft">
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-blue-600 shrink-0">
                <path d="M8 1.5 13.5 3.5v4c0 3.2-2.3 5.9-5.5 7-3.2-1.1-5.5-3.8-5.5-7v-4z"></path>
                <path d="m5.8 8 1.6 1.6 2.8-3"></path>
              </svg>
              KRA-Compliant Process
            </div>
            <div class="flex items-center gap-2 text-[0.85rem] font-medium text-ink-soft">
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-blue-600 shrink-0">
                <circle cx="8" cy="8" r="6.5"></circle>
                <path d="M8 4.5v7M9.8 5.8c-.4-.5-1-.8-1.8-.8-1 0-1.8.6-1.8 1.4 0 2 3.6 1 3.6 3 0 .8-.8 1.4-1.8 1.4-.8 0-1.5-.3-1.9-.9"></path>
              </svg>
              M-PESA Receipts
            </div>
            <div class="flex items-center gap-2 text-[0.85rem] font-medium text-ink-soft">
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" class="text-blue-600 shrink-0">
                <circle cx="8" cy="8" r="6.5"></circle>
                <path d="m3.5 12.5 9-9"></path>
              </svg>
              No Hidden Fees
            </div>
          </div>
        </div>

        <!-- Tool column: the working calculator -->
        <div class="w-full max-w-[640px] mx-auto lg:mx-0 lg:justify-self-end min-w-0">
          <HeroVatCalc client:load />
          <div class="mt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
            <a
              href="/kra-status/"
              class="flex-1 inline-flex items-center justify-center gap-2 rounded-lg border border-hairline bg-card px-4 py-2.5 text-[0.8rem] font-medium text-ink-soft hover:border-ink-muted transition-colors"
            >
              <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
                <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-60 animate-ping"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-600"></span>
              </span>
              KRA system status
            </a>
            <a
              href="/tax-amnesty-2026/"
              class="flex-1 inline-flex items-center justify-center gap-2 rounded-lg border border-brand/25 bg-brand-muted px-4 py-2.5 text-[0.8rem] font-semibold text-brand-hover hover:border-brand/50 transition-colors"
            >
              Amnesty ends 31 Dec 2026 — check if you qualify
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <HomePage />
</BaseLayout>
