---
import BaseLayout from "@/src/layouts/BaseLayout.astro"
import { ResourceSearch } from "@/components/resource-search"

const pillars = [
  { slug: "how-to-register-for-vat-in-kenya", number: "01", label: "Registration", title: "How to Register for VAT in Kenya on iTax", bluf: "Step-by-step KRA iTax VAT registration guide. Documents needed, KES 5M threshold, timeline, and what happens after you register.", readTime: "8 min", tags: ["Registration"] },
  { slug: "kra-penalty-for-late-vat-filing", number: "02", label: "Penalties", title: "KRA Penalty for Late VAT Filing: How Much and How to Apply for a Waiver", bluf: "KES 10,000 fixed penalty + 5% of tax due + 1% monthly interest. Learn how to check penalties on iTax and apply for a KRA penalty waiver.", readTime: "7 min", tags: ["Penalties"] },
  { slug: "how-to-calculate-vat-in-kenya", number: "03", label: "Calculations", title: "How to Calculate 16% VAT in Kenya", bluf: "VAT exclusive, VAT inclusive, and input/output VAT calculations with worked examples. Includes standard, zero-rated, and exempt scenarios.", readTime: "6 min", tags: ["Calculations"] },
  { slug: "how-to-file-vat-return-on-itax", number: "04", label: "Filing", title: "How to File Your VAT Return on KRA iTax", bluf: "Complete guide to filing VAT returns on iTax before the 20th. Dashboard navigation, invoice listing, filing, and penalty checks.", readTime: "7 min", tags: ["Filing"] },
  { slug: "do-i-need-to-register-for-vat-kenya", number: "05", label: "Threshold", title: "Do I Need to Register for VAT in Kenya?", bluf: "KES 5 million annual turnover threshold, voluntary registration, non-resident rules, and penalties for not registering. Includes a decision flowchart.", readTime: "6 min", tags: ["Registration"] },
  { slug: "itax-portal-not-working", number: "06", label: "Troubleshooting", title: "KRA iTax Portal Not Working? Common Errors and Fixes", bluf: "When iTax won't load, login fails, or pages won't render. Step-by-step troubleshooting for the most common iTax technical issues.", readTime: "5 min", tags: ["Troubleshooting"] },
  { slug: "etims-onboarding-guide", number: "07", label: "eTIMS", title: "eTIMS Kenya Onboarding Guide 2026", bluf: "Complete eTIMS onboarding guide. Who must register, KES 50,000 fine, step-by-step iTax setup, SDK integration, and offline invoicing.", readTime: "10 min", tags: ["eTIMS"], featured: true },
  { slug: "vat-vs-turnover-tax", number: "08", label: "Comparison", title: "Turnover Tax vs VAT in Kenya 2026", bluf: "VAT vs Turnover Tax comparison — threshold, rates, filing frequency, input VAT, and how to choose the right tax regime for your business.", readTime: "6 min", tags: ["Comparison"] },
  { slug: "kra-vat-penalties-reference", number: "09", label: "Penalties", title: "KRA VAT Penalties Kenya 2026: Complete Reference", bluf: "Complete reference to all KRA VAT penalties — late registration, late filing, late payment, eTIMS non-compliance, and incorrect returns.", readTime: "8 min", tags: ["Penalties"] },
  { slug: "vat-registration-checklist", number: "10", label: "Registration", title: "VAT Registration Kenya Checklist 2026", bluf: "Complete checklist of everything you need for KRA VAT registration — documents, information, and step-by-step preparation.", readTime: "5 min", tags: ["Registration"] },
  { slug: "nil-returns-tax-amnesty", number: "11", label: "Amnesty", title: "Nil Returns Kenya 2026: File on iTax + Tax Amnesty", bluf: "How to file nil returns on iTax and clear outstanding penalties through the KRA tax amnesty programme — 100% penalty and interest waiver.", readTime: "8 min", tags: ["Filing"], featured: true },
  { slug: "vat-for-startups-tech-businesses", number: "12", label: "Industry", title: "VAT for Startups and Tech Businesses in Kenya", bluf: "VAT compliance tailored for Kenyan startups and tech companies — equity vs revenue, software licensing, input VAT on development costs.", readTime: "5 min", tags: ["Startups"] },
  { slug: "vat-special-table-risks", number: "13", label: "Compliance", title: "KRA VAT Special Table: Risks and How to Get Removed", bluf: "What the KRA VAT Special Table is, why your business might be on it, and how to get removed. Includes application steps and document requirements.", readTime: "6 min", tags: ["Compliance"] },
  { slug: "vat-rates-kenya", number: "14", label: "Rates", title: "VAT Rates in Kenya 2026 — Standard, Zero-Rated & Exempt", bluf: "Kenya's three-tier VAT system explained. Standard 16%, zero-rated supplies (full list from First Schedule), and exempt supplies (Second Schedule).", readTime: "8 min", tags: ["Rates"] },
  { slug: "etims-invoicing-guide", number: "15", label: "eTIMS", title: "eTIMS Compliant Invoice Guide Kenya 2026", bluf: "How to issue VAT-compliant eTIMS invoices in Kenya. Required fields, QR codes, invoice types (E, T, C, D), and common formatting mistakes.", readTime: "7 min", tags: ["eTIMS"] },
  { slug: "vat-auto-populated-return", number: "16", label: "Filing", title: "KRA Auto-Populated VAT Return Guide", bluf: "How KRA auto-populated VAT returns work, how to review and adjust pre-filled data, and what to do if the auto-populated amounts are wrong.", readTime: "6 min", tags: ["Filing"] },
  { slug: "input-vat-deduction-guide", number: "17", label: "Calculations", title: "Input VAT Deduction Kenya 2026", bluf: "Complete guide to input VAT deduction in Kenya. What qualifies, time limits, apportionment for mixed supplies, blocked inputs, and documentation.", readTime: "7 min", tags: ["Calculations"] },
  { slug: "withholding-vat-kenya", number: "18", label: "Compliance", title: "Withholding VAT in Kenya 2026", bluf: "Withholding VAT explained — who deducts, who receives, 2%/6% rates, invoicing requirements, iTax reporting, and claiming credit for withheld VAT.", readTime: "7 min", tags: ["Compliance"] },
  { slug: "vat-digital-services-kenya", number: "19", label: "Digital", title: "VAT on Digital Services in Kenya 2026", bluf: "VAT on digital services — e-books, streaming, SaaS, online advertising. Non-resident rules, KRA registration, and how VAT applies to digital products.", readTime: "7 min", tags: ["Digital"], featured: true },
  { slug: "vat-refund-guide-kenya", number: "20", label: "Refunds", title: "KRA VAT Refund Guide Kenya 2026", bluf: "How to apply for a KRA VAT refund. Excess input VAT, exported goods, refund process steps on iTax, required documents, and waiting times.", readTime: "7 min", tags: ["Refunds"] },
  { slug: "finance-act-vat-changes-kenya", number: "21", label: "Updates", title: "Finance Act 2025 & 2026 VAT Changes Kenya", bluf: "VAT changes from the Finance Act 2025 and 2026 — payment processing VAT, 90:10 rule removal, KDF exemption, mosquito repellent exemption.", readTime: "6 min", tags: ["Updates"] },
  { slug: "vat-fintech-digital-payments-kenya", number: "22", label: "Industry", title: "VAT on Fintech and Digital Payments in Kenya", bluf: "How the Finance Act 2026 reclassified payment processing services from exempt to 16% VAT. Merchant fees, gateway fees, and compliance requirements.", readTime: "6 min", tags: ["Fintech"] },
  { slug: "vat-labour-outsourcing-kenya", number: "23", label: "Industry", title: "VAT on Labour Outsourcing and Staff Costs Kenya", bluf: "How VAT applies to labour outsourcing — staff placement, temp labour, employee costs as disbursements vs taxable supplies.", readTime: "5 min", tags: ["Labour"] },
  { slug: "kra-vat-filing-deadline-august-2026", number: "24", label: "Deadlines", title: "KRA VAT Filing Deadline August 2026", bluf: "When is the next KRA VAT return deadline? Calendar of monthly VAT deadlines, special end-of-year dates, and what happens if you miss the 20th.", readTime: "4 min", tags: ["Deadlines"] },
  { slug: "etims-penalty-50000-per-month-kenya", number: "25", label: "eTIMS", title: "eTIMS Penalty KES 50,000 Per Month", bluf: "What the KES 50,000 per month eTIMS non-compliance penalty covers, when it applies, who must comply, and how to avoid the fine.", readTime: "5 min", tags: ["eTIMS"] },
  { slug: "vat-for-landlords-kenya", number: "26", label: "Industry", title: "VAT for Landlords Kenya 2026", bluf: "VAT for Kenyan landlords — residential rent (exempt) vs commercial rent (16%), input VAT on construction, and mixed-use property apportionment.", readTime: "6 min", tags: ["Property"] },
  { slug: "vat-for-restaurants-hospitality", number: "27", label: "Industry", title: "VAT for Restaurants & Hospitality Kenya", bluf: "VAT compliance for Kenyan restaurants, hotels, and caterers — food vs drink, accommodation, event catering, and common classification mistakes.", readTime: "5 min", tags: ["Hospitality"] },
  { slug: "vat-for-importers-kenya", number: "28", label: "Industry", title: "VAT for Importers Kenya 2026", bluf: "Import VAT at 16%, customs valuation, duty + VAT calculation, deferment, remission schemes, and documentary requirements.", readTime: "6 min", tags: ["Imports"] },
  { slug: "kra-vat-audit-process", number: "29", label: "Compliance", title: "KRA VAT Audit Process Kenya 2026", bluf: "What happens during a KRA VAT audit — notification, document requests, site visits, timeline, and how to prepare your records.", readTime: "5 min", tags: ["Compliance"] },
  { slug: "how-to-apply-for-kra-pin", number: "30", label: "Registration", title: "How to Apply for a KRA PIN in Kenya", bluf: "Step-by-step guide to applying for a KRA PIN online — individual, business, and non-resident applications on iTax.", readTime: "5 min", tags: ["Registration"] },
  { slug: "vat-deregistration-kenya", number: "31", label: "Registration", title: "VAT Deregistration Kenya 2026", bluf: "When and how to deregister from VAT in Kenya. Below-threshold, business closure, voluntary deregistration, and the iTax process.", readTime: "5 min", tags: ["Registration"] },
  { slug: "vat-for-ngos-kenya", number: "32", label: "Industry", title: "VAT for NGOs in Kenya 2026", bluf: "VAT treatment for NGOs in Kenya — exempt imports, input VAT on local purchases, VAT on grant income, and compliance obligations.", readTime: "5 min", tags: ["NGOs"] },
  { slug: "kra-status-code-500-itax-errors", number: "33", label: "Troubleshooting", title: "KRA Status Code 500 iTax Errors", bluf: "What KRA Status Code 500 means on iTax, why it happens, and how to fix it. Includes other common gateway and server error codes.", readTime: "4 min", tags: ["Troubleshooting"] },
  { slug: "small-taxpayer-regime-kenya", number: "34", label: "Comparison", title: "Small Taxpayer Regime Kenya 2026", bluf: "Kenya's Small Taxpayer Regime explained — who qualifies, turnover thresholds, tax rates, filing requirements, and how it compares to VAT and TOT.", readTime: "6 min", tags: ["Comparison"] },
  { slug: "etims-down-offline-invoicing", number: "35", label: "eTIMS", title: "KRA eTIMS Down? Offline Invoicing Guide", bluf: "What to do when eTIMS is down — offline invoicing procedures, KRA-approved methods, and how to stay compliant during system outages.", readTime: "5 min", tags: ["eTIMS"] },
  { slug: "etims-compliance-checklist", number: "36", label: "eTIMS", title: "eTIMS Compliance Checklist Kenya 2026", bluf: "Complete eTIMS compliance checklist — hardware, software, invoicing, reporting, and record-keeping requirements.", readTime: "5 min", tags: ["eTIMS"] },
  { slug: "kra-tax-amnesty-2026", number: "37", label: "Amnesty", title: "KRA Tax Amnesty 2026: 100% Penalty and Interest Waiver", bluf: "KRA Tax Amnesty 2026 programme — voluntary disclosure, 100% penalty and interest waiver, how to apply on iTax, and eligibility criteria.", readTime: "7 min", tags: ["Amnesty"], featured: true },
  { slug: "vat-for-construction-real-estate-kenya", number: "38", label: "Industry", title: "VAT for Construction & Real Estate Kenya", bluf: "VAT for construction and real estate — commercial vs residential, input VAT on materials, subcontractor invoices, and land transactions.", readTime: "6 min", tags: ["Construction"] },
  { slug: "vat-return-filing-checklist", number: "39", label: "Filing", title: "VAT Return Filing Checklist Kenya 2026", bluf: "Before you file your VAT return on iTax — complete checklist covering documents, calculations, reconciliations, and common errors to avoid.", readTime: "5 min", tags: ["Filing"] },
  { slug: "tax-compliance-certificate-kenya", number: "40", label: "Compliance", title: "How to Get a Tax Compliance Certificate in Kenya", bluf: "Complete guide to getting a KRA Tax Compliance Certificate — requirements, iTax application steps, processing time, and what blocks issuance.", readTime: "6 min", tags: ["Compliance"] },
  { slug: "kra-pin-not-working", number: "41", label: "Troubleshooting", title: "KRA PIN Not Working? Common Reasons and Fixes", bluf: "Why your KRA PIN might not be working on iTax — pending registration, deactivation, wrong format, and how to resolve each issue.", readTime: "5 min", tags: ["Troubleshooting"] },
  { slug: "etims-invoice-rejected", number: "42", label: "eTIMS", title: "eTIMS Invoice Rejected by KRA? Common Errors and Fixes", bluf: "Why eTIMS invoices get rejected by KRA — common validation errors, incorrect fields, QR code issues, and how to resubmit.", readTime: "5 min", tags: ["eTIMS"] },
  { slug: "vat-auto-populated-return", number: "42", label: "Filing", title: "KRA Auto-Populated VAT Return: How to Review and Adjust", bluf: "KRA auto-populated VAT returns are here. Learn how to review pre-filled data, make adjustments, and avoid overpaying or underpaying VAT.", readTime: "6 min", tags: ["Filing"] },
  { slug: "what-happens-if-i-don-t-register-for-vat", number: "43", label: "Penalties", title: "What Happens If I Don't Register for VAT in Kenya?", bluf: "Consequences of not registering for VAT — penalties, interest, backdated tax assessments, agency notices, and criminal prosecution risks.", readTime: "5 min", tags: ["Penalties"] },
  { slug: "withholding-vat-kenya", number: "44", label: "Compliance", title: "Withholding VAT in Kenya 2026", bluf: "Complete guide to withholding VAT — who is required to deduct, the 2% and 6% rates, invoicing requirements, and claiming credit.", readTime: "7 min", tags: ["Compliance"] },
  { slug: "vat-refund-guide-kenya", number: "45", label: "Refunds", title: "KRA VAT Refund Guide Kenya 2026", bluf: "How to apply for a VAT refund from KRA. Step-by-step iTax application process, required documents, processing timeline, and common reasons for rejection.", readTime: "7 min", tags: ["Refunds"] },
]

// Remove duplicates by slug
const uniquePillars = pillars.filter((p, i, arr) => arr.findIndex((x) => x.slug === p.slug) === i)
---

<BaseLayout title="Kenya VAT Knowledge Base — Free KRA Guides for SMEs 2026" description="Free Kenya VAT knowledge base for SMEs. How to register for VAT on KRA iTax, calculate 16% VAT, file nil returns, apply for the KRA tax amnesty programme, file monthly returns, get a KRA penalty waiver, and decide if you need to register for VAT." path="/resources">
  <main class="max-w-[1400px] mx-auto px-6 lg:px-10 pt-12 lg:pt-16 pb-20 lg:pb-24">
    <header class="mb-12">
      <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-brand mb-3">Knowledge Base</p>
      <h1 class="font-display text-[clamp(1.8rem,4vw,2.8rem)] font-semibold text-ink tracking-tight leading-tight mb-4 text-balance">
        Kenya VAT Knowledge Base
      </h1>
      <p class="text-[0.95rem] text-ink-muted leading-relaxed max-w-[56ch]">
        Free guides written for Kenyan SMEs. How to register for VAT, file returns, calculate 16% VAT, get a penalty waiver, compare Turnover Tax vs VAT, and understand eTIMS compliance. Updated for 2026.
      </p>
    </header>

    <ResourceSearch pillars={uniquePillars} client:visible />
  </main>
</BaseLayout>
