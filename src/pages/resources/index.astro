---
import BaseLayout from "@/src/layouts/BaseLayout.astro"
import { ResourceSearch } from "@/components/resource-search"

const pillars = [
  { slug: "cetis-kenya-2027", number: "Special Edition", label: "e-Invoicing", title: "CETIS Kenya 2027: Pre-Clearance e-Invoicing Explained", bluf: "KRA's Comprehensive Electronic Tax Invoicing System is in procurement for 2027–28. Every invoice validated and signed by KRA before it reaches the buyer. Uganda's EFRIS lessons and how to prepare now.", readTime: "6 min", tags: ["e-Invoicing"], featured: true },
  { slug: "kra-data-sources", number: "Special Edition", label: "Data", title: "KRA Data Sources Kenya - Official VAT & Revenue Data", bluf: "Where analysts source official KRA data: KRA Publications, iKESRA, GavaConnect APIs, openAFRICA, KNBS and National Treasury - all free, direct download pages.", readTime: "4 min", tags: ["Data"], featured: true },
  { slug: "youtube-5-percent-tax-kenya", number: "Special Edition", label: "Breaking", title: "YouTube 5% Tax Kenya: How Much You'll Actually Lose", bluf: "Google is withholding 5% of AdSense earnings from October - and holding payments entirely if your KRA PIN is missing on 1 Oct. The exact math, with calculator.", readTime: "6 min", tags: ["Creators", "Withholding"], featured: true },
  { slug: "consolidated-cargo-benchmark-kenya", number: "Special Edition", label: "Breaking", title: "Consolidated Cargo Tax Kenya: New Sh2M Benchmark", bluf: "The 2 September cargo benchmark cut from Sh3.2M to Sh2M - what changed at customs, the garment/footwear/fabric exclusion list, and a printable one-pager for your clearing agent.", readTime: "5 min", tags: ["Customs", "Importers"], featured: true },
  { slug: "real-cost-of-taxes-kenyan-sme", number: "Special Edition", label: "Deep Dive", title: "The Real Tax on Running a Small Business in Kenya", bluf: "Every levy a Kenyan SME actually pays - VAT, PAYE, housing levy, NSSF, SHIF, permits, eTIMS - in one worked example at KES 6M turnover, plus the four legal ways to shrink it.", readTime: "8 min", tags: ["SME", "All Taxes"] },
  { slug: "vat-registration-kenya-compare-options", number: "01", label: "Comparison", title: "VAT Registration Kenya: Compare All 3 Options", bluf: "DIY on iTax (free, ~3 weeks), traditional facilitators (KES 15,000-30,000), or flat-fee online agents (KES 5,000, 1-3 days). The honest cost-time-risk comparison.", readTime: "7 min", tags: ["Registration", "Pricing"] },
  { slug: "etims-vs-kra-shuru-chatbot", number: "02", label: "Comparison", title: "eTIMS vs KRA Shuru Chatbot: What Each Does", bluf: "KRA's Shuru WhatsApp chatbot files simple returns free. It can't fix rejected eTIMS invoices, waivers or complex errors. Where the bot stops and a human starts.", readTime: "5 min", tags: ["KRA", "Tools"] },
  { slug: "vat-commercial-rent-kenya", number: "03", label: "Property", title: "VAT on Commercial Rent Kenya: When 16% Applies", bluf: "Commercial rent is VAT-able at 16% above KES 5M taxable turnover; residential rent is exempt. Registration, eTIMS rent invoicing, mixed-use apportionment, input VAT.", readTime: "7 min", tags: ["Landlords", "Property"] },
  { slug: "how-to-register-for-vat-in-kenya", number: "04", label: "Registration", title: "How to Register for VAT in Kenya on iTax", bluf: "Step-by-step KRA iTax VAT registration guide. Documents needed, KES 5M threshold, timeline, and what happens after you register.", readTime: "8 min", tags: ["Registration"] },
  { slug: "kra-penalty-for-late-vat-filing", number: "05", label: "Penalties", title: "KRA Penalty for Late VAT Filing: How Much and How to Apply for a Waiver", bluf: "KES 10,000 fixed penalty + 5% of tax due + 1% monthly interest. Learn how to check penalties on iTax and apply for a KRA penalty waiver.", readTime: "7 min", tags: ["Penalties"] },
  { slug: "how-to-calculate-vat-in-kenya", number: "06", label: "Calculations", title: "How to Calculate 16% VAT in Kenya", bluf: "VAT exclusive, VAT inclusive, and input/output VAT calculations with worked examples. Includes standard, zero-rated, and exempt scenarios.", readTime: "6 min", tags: ["Calculations"] },
  { slug: "how-to-file-vat-return-on-itax", number: "07", label: "Filing", title: "How to File Your VAT Return on KRA iTax", bluf: "Complete guide to filing VAT returns on iTax before the 20th. Dashboard navigation, invoice listing, filing, and penalty checks.", readTime: "7 min", tags: ["Filing"] },
  { slug: "do-i-need-to-register-for-vat-kenya", number: "08", label: "Threshold", title: "Do I Need to Register for VAT in Kenya?", bluf: "KES 5 million annual turnover threshold, voluntary registration, non-resident rules, and penalties for not registering. Includes a decision flowchart.", readTime: "6 min", tags: ["Registration"] },
  { slug: "itax-portal-not-working", number: "09", label: "Troubleshooting", title: "KRA iTax Portal Not Working? Common Errors and Fixes", bluf: "When iTax won't load, login fails, or pages won't render. Step-by-step troubleshooting for the most common iTax technical issues.", readTime: "5 min", tags: ["Troubleshooting"] },
  { slug: "etims-onboarding-guide", number: "10", label: "eTIMS", title: "eTIMS Kenya Onboarding Guide 2026", bluf: "Complete eTIMS onboarding guide. Who must register, KES 50,000 fine, step-by-step iTax setup, SDK integration, and offline invoicing.", readTime: "10 min", tags: ["eTIMS"], featured: true },
  { slug: "vat-vs-turnover-tax", number: "11", label: "Comparison", title: "Turnover Tax vs VAT in Kenya 2026", bluf: "VAT vs Turnover Tax comparison - threshold, rates, filing frequency, input VAT, and how to choose the right tax regime for your business.", readTime: "6 min", tags: ["Comparison"] },
  { slug: "kra-vat-penalties-reference", number: "12", label: "Penalties", title: "KRA VAT Penalties Kenya 2026: Complete Reference", bluf: "Complete reference to all KRA VAT penalties - late registration, late filing, late payment, eTIMS non-compliance, and incorrect returns.", readTime: "8 min", tags: ["Penalties"] },
  { slug: "vat-registration-checklist", number: "13", label: "Registration", title: "VAT Registration Kenya Checklist 2026", bluf: "Complete checklist of everything you need for KRA VAT registration - documents, information, and step-by-step preparation.", readTime: "5 min", tags: ["Registration"] },
  { slug: "nil-returns-tax-amnesty", number: "14", label: "Amnesty", title: "Nil Returns Kenya 2026: File on iTax + Tax Amnesty", bluf: "How to file nil returns on iTax and clear outstanding penalties through the KRA tax amnesty programme - 100% penalty and interest waiver.", readTime: "8 min", tags: ["Filing"], featured: true },
  { slug: "vat-for-startups-tech-businesses", number: "15", label: "Industry", title: "VAT for Startups and Tech Businesses in Kenya", bluf: "VAT compliance tailored for Kenyan startups and tech companies - equity vs revenue, software licensing, input VAT on development costs.", readTime: "5 min", tags: ["Startups"] },
  { slug: "vat-special-table-risks", number: "16", label: "Compliance", title: "KRA VAT Special Table: Risks and How to Get Removed", bluf: "What the KRA VAT Special Table is, why your business might be on it, and how to get removed. Includes application steps and document requirements.", readTime: "6 min", tags: ["Compliance"] },
  { slug: "vat-rates-kenya", number: "17", label: "Rates", title: "VAT Rates in Kenya 2026 - Standard, Zero-Rated & Exempt", bluf: "Kenya's three-tier VAT system explained. Standard 16%, zero-rated supplies (full list from First Schedule), and exempt supplies (Second Schedule).", readTime: "8 min", tags: ["Rates"] },
  { slug: "etims-invoicing-guide", number: "18", label: "eTIMS", title: "eTIMS Compliant Invoice Guide Kenya 2026", bluf: "How to issue VAT-compliant eTIMS invoices in Kenya. Required fields, QR codes, invoice types (E, T, C, D), and common formatting mistakes.", readTime: "7 min", tags: ["eTIMS"] },
  { slug: "vat-auto-populated-return", number: "19", label: "Filing", title: "KRA Auto-Populated VAT Return Guide", bluf: "How KRA auto-populated VAT returns work, how to review and adjust pre-filled data, and what to do if the auto-populated amounts are wrong.", readTime: "6 min", tags: ["Filing"] },
  { slug: "input-vat-deduction-guide", number: "20", label: "Calculations", title: "Input VAT Deduction Kenya 2026", bluf: "Complete guide to input VAT deduction in Kenya. What qualifies, time limits, apportionment for mixed supplies, blocked inputs, and documentation.", readTime: "7 min", tags: ["Calculations"] },
  { slug: "withholding-vat-kenya", number: "21", label: "Compliance", title: "Withholding VAT in Kenya 2026", bluf: "Withholding VAT explained - who deducts, who receives, 2%/6% rates, invoicing requirements, iTax reporting, and claiming credit for withheld VAT.", readTime: "7 min", tags: ["Compliance"] },
  { slug: "vat-digital-services-kenya", number: "22", label: "Digital", title: "VAT on Digital Services in Kenya 2026", bluf: "VAT on digital services - e-books, streaming, SaaS, online advertising. Non-resident rules, KRA registration, and how VAT applies to digital products.", readTime: "7 min", tags: ["Digital"], featured: true },
  { slug: "vat-refund-guide-kenya", number: "23", label: "Refunds", title: "KRA VAT Refund Guide Kenya 2026", bluf: "How to apply for a KRA VAT refund. Excess input VAT, exported goods, refund process steps on iTax, required documents, and waiting times.", readTime: "7 min", tags: ["Refunds"] },
  { slug: "finance-act-vat-changes-kenya", number: "24", label: "Updates", title: "Finance Act 2025 & 2026 VAT Changes Kenya", bluf: "VAT changes from the Finance Act 2025 and 2026 - payment processing VAT, 90:10 rule removal, KDF exemption, mosquito repellent exemption.", readTime: "6 min", tags: ["Updates"] },
  { slug: "vat-fintech-digital-payments-kenya", number: "25", label: "Industry", title: "VAT on Fintech and Digital Payments in Kenya", bluf: "How the Finance Act 2026 reclassified payment processing services from exempt to 16% VAT. Merchant fees, gateway fees, and compliance requirements.", readTime: "6 min", tags: ["Fintech"] },
  { slug: "vat-labour-outsourcing-kenya", number: "26", label: "Industry", title: "VAT on Labour Outsourcing and Staff Costs Kenya", bluf: "How VAT applies to labour outsourcing - staff placement, temp labour, employee costs as disbursements vs taxable supplies.", readTime: "5 min", tags: ["Labour"] },
  { slug: "etims-penalty-50000-per-month-kenya", number: "27", label: "eTIMS", title: "eTIMS Penalties Kenya: Facts, Not Circulating Figures", bluf: "eTIMS penalties by legal basis: what TPA s.86 and s.59A(5) actually provide, why figures like KES 1M/10% or KES 500,000/month are not enacted law, and where the KES 50,000 figure comes from.", readTime: "5 min", tags: ["eTIMS"] },
  { slug: "vat-for-landlords-kenya", number: "28", label: "Industry", title: "VAT for Landlords Kenya 2026", bluf: "VAT for Kenyan landlords - residential rent (exempt) vs commercial rent (16%), input VAT on construction, and mixed-use property apportionment.", readTime: "6 min", tags: ["Property"] },
  { slug: "vat-for-restaurants-hospitality", number: "29", label: "Industry", title: "VAT for Restaurants & Hospitality Kenya", bluf: "VAT compliance for Kenyan restaurants, hotels, and caterers - food vs drink, accommodation, event catering, and common classification mistakes.", readTime: "5 min", tags: ["Hospitality"] },
  { slug: "vat-for-importers-kenya", number: "30", label: "Industry", title: "VAT for Importers Kenya 2026", bluf: "Import VAT at 16%, customs valuation, duty + VAT calculation, deferment, remission schemes, and documentary requirements.", readTime: "6 min", tags: ["Imports"] },
  { slug: "kra-vat-audit-process", number: "31", label: "Compliance", title: "KRA VAT Audit Process Kenya 2026", bluf: "What happens during a KRA VAT audit - notification, document requests, site visits, timeline, and how to prepare your records.", readTime: "5 min", tags: ["Compliance"] },
  { slug: "how-to-apply-for-kra-pin", number: "32", label: "Registration", title: "How to Apply for a KRA PIN in Kenya", bluf: "Step-by-step guide to applying for a KRA PIN online - individual, business, and non-resident applications on iTax.", readTime: "5 min", tags: ["Registration"] },
  { slug: "vat-deregistration-kenya", number: "33", label: "Registration", title: "VAT Deregistration Kenya 2026", bluf: "When and how to deregister from VAT in Kenya. Below-threshold, business closure, voluntary deregistration, and the iTax process.", readTime: "5 min", tags: ["Registration"] },
  { slug: "vat-for-ngos-kenya", number: "34", label: "Industry", title: "VAT for NGOs in Kenya 2026", bluf: "VAT treatment for NGOs in Kenya - exempt imports, input VAT on local purchases, VAT on grant income, and compliance obligations.", readTime: "5 min", tags: ["NGOs"] },
  { slug: "kra-status-code-500-itax-errors", number: "35", label: "Troubleshooting", title: "KRA Status Code 500 iTax Errors", bluf: "What KRA Status Code 500 means on iTax, why it happens, and how to fix it. Includes other common gateway and server error codes.", readTime: "4 min", tags: ["Troubleshooting"] },
  { slug: "small-taxpayer-regime-kenya", number: "36", label: "Comparison", title: "Small Taxpayer Regime Kenya 2026", bluf: "Kenya's Small Taxpayer Regime explained - who qualifies, turnover thresholds, tax rates, filing requirements, and how it compares to VAT and TOT.", readTime: "6 min", tags: ["Comparison"] },
  { slug: "etims-down-offline-invoicing", number: "37", label: "eTIMS", title: "KRA eTIMS Down? Offline Invoicing Guide", bluf: "What to do when eTIMS is down - offline invoicing procedures, KRA-approved methods, and how to stay compliant during system outages.", readTime: "5 min", tags: ["eTIMS"] },
  { slug: "etims-compliance-checklist", number: "38", label: "eTIMS", title: "eTIMS Compliance Checklist Kenya 2026", bluf: "Complete eTIMS compliance checklist - hardware, software, invoicing, reporting, and record-keeping requirements.", readTime: "5 min", tags: ["eTIMS"] },
  { slug: "kra-tax-amnesty-2026", number: "39", label: "Amnesty", title: "KRA Tax Amnesty 2026: 100% Penalty and Interest Waiver", bluf: "KRA Tax Amnesty 2026 programme - voluntary disclosure, 100% penalty and interest waiver, how to apply on iTax, and eligibility criteria.", readTime: "7 min", tags: ["Amnesty"], featured: true },
  { slug: "vat-for-construction-real-estate-kenya", number: "40", label: "Industry", title: "VAT for Construction & Real Estate Kenya", bluf: "VAT for construction and real estate - commercial vs residential, input VAT on materials, subcontractor invoices, and land transactions.", readTime: "6 min", tags: ["Construction"] },
  { slug: "vat-return-filing-checklist", number: "41", label: "Filing", title: "VAT Return Filing Checklist Kenya 2026", bluf: "Before you file your VAT return on iTax - complete checklist covering documents, calculations, reconciliations, and common errors to avoid.", readTime: "5 min", tags: ["Filing"] },
  { slug: "tax-compliance-certificate-kenya", number: "42", label: "Compliance", title: "How to Get a Tax Compliance Certificate in Kenya", bluf: "Complete guide to getting a KRA Tax Compliance Certificate - requirements, iTax application steps, processing time, and what blocks issuance.", readTime: "6 min", tags: ["Compliance"] },
  { slug: "kra-pin-not-working", number: "43", label: "Troubleshooting", title: "KRA PIN Not Working? Common Reasons and Fixes", bluf: "Why your KRA PIN might not be working on iTax - pending registration, deactivation, wrong format, and how to resolve each issue.", readTime: "5 min", tags: ["Troubleshooting"] },
  { slug: "etims-invoice-rejected", number: "44", label: "eTIMS", title: "eTIMS Invoice Rejected by KRA? Common Errors and Fixes", bluf: "Why eTIMS invoices get rejected by KRA - common validation errors, incorrect fields, QR code issues, and how to resubmit.", readTime: "5 min", tags: ["eTIMS"] },
  { slug: "vat-auto-populated-return", number: "45", label: "Filing", title: "KRA Auto-Populated VAT Return: How to Review and Adjust", bluf: "KRA auto-populated VAT returns are here. Learn how to review pre-filled data, make adjustments, and avoid overpaying or underpaying VAT.", readTime: "6 min", tags: ["Filing"] },
  { slug: "what-happens-if-i-don-t-register-for-vat", number: "46", label: "Penalties", title: "What Happens If I Don't Register for VAT in Kenya?", bluf: "Consequences of not registering for VAT - penalties, interest, backdated tax assessments, agency notices, and criminal prosecution risks.", readTime: "5 min", tags: ["Penalties"] },
  { slug: "withholding-vat-kenya", number: "47", label: "Compliance", title: "Withholding VAT in Kenya 2026", bluf: "Complete guide to withholding VAT - who is required to deduct, the 2% and 6% rates, invoicing requirements, and claiming credit.", readTime: "7 min", tags: ["Compliance"] },
  { slug: "vat-refund-guide-kenya", number: "48", label: "Refunds", title: "KRA VAT Refund Guide Kenya 2026", bluf: "How to apply for a VAT refund from KRA. Step-by-step iTax application process, required documents, processing timeline, and common reasons for rejection.", readTime: "7 min", tags: ["Refunds"] },
  { slug: "how-to-file-nil-returns-2026", number: "49", label: "Filing", title: "How to File Nil Returns on KRA iTax Kenya 2026", bluf: "Complete guide to filing nil returns on KRA iTax for VAT, income tax, and turnover tax: monthly nil returns, the No Obligation PIN status, and penalties.", readTime: "8 min", tags: ["Filing"] },
  { slug: "etims-can-i-claim-my-expenses", number: "50", label: "eTIMS", title: "Fuel, Rent, KPLC & Safaricom eTIMS Receipts - What You Can Claim", bluf: "Can you claim fuel, Safaricom internet, KPLC electricity, rent and M-Pesa payments as business expenses in 2026? The exact eTIMS receipt rules.", readTime: "5 min", tags: ["eTIMS"] },
  { slug: "etims-corporate-client-invoice-requirement", number: "51", label: "eTIMS", title: "Client Asking for eTIMS Invoice? The 5-Day Fix for Small Suppliers", bluf: "Corporate clients now demand eTIMS invoices before they pay. Small suppliers are losing accounts over late onboarding - here's the five-day fix.", readTime: "5 min", tags: ["eTIMS"] },
  { slug: "etims-fuel-stations", number: "52", label: "eTIMS", title: "Petrol Station Refusing an eTIMS Receipt? Here's Why and What to Do", bluf: "KRA made eTIMS mandatory for all fuel stations by June 30, 2025. What to do when a station won't issue an eTIMS receipt, and what it costs owners.", readTime: "5 min", tags: ["eTIMS"] },
  { slug: "etims-penalties-2026", number: "53", label: "eTIMS", title: "eTIMS Penalties 2026 - Exact Figures From the Law", bluf: "A legal breakdown of KRA eTIMS penalties under Tax Procedures Act s.86 (as amended by Finance Act 2026) and s.59A(5), separating law from myths.", readTime: "6 min", tags: ["eTIMS"] },
  { slug: "etims-what-does-kra-see", number: "54", label: "eTIMS", title: "Can KRA See My M-Pesa? eTIMS Monitoring Explained", bluf: "Does eTIMS let KRA spy on your M-Pesa balance, phone or bank account? Exactly what KRA can and cannot see through eTIMS in 2026.", readTime: "6 min", tags: ["eTIMS"] },
  { slug: "how-to-register-kra-pin-individual", number: "55", label: "Registration", title: "How to Register a KRA PIN for Individuals in Kenya", bluf: "Step-by-step guide to registering an individual KRA PIN online via iTax. Requirements, ID card upload, and activation.", readTime: "4 min", tags: ["Registration"] },
  { slug: "kra-pin-registration-foreigners", number: "56", label: "Registration", title: "KRA PIN Registration for Foreigners in Kenya", bluf: "Complete guide for non-citizens and expatriates on how to get a KRA PIN in Kenya. Requirements, passport upload, work permits, and online iTax steps.", readTime: "5 min", tags: ["Registration"] },
  { slug: "vat-for-freelancers-creators", number: "57", label: "Industry", title: "VAT for Freelancers & Creators in Kenya 2026", bluf: "Do digital creators, freelance developers, and remote consultants in Kenya need a KRA PIN and VAT registration? Threshold rules and eTIMS compliance.", readTime: "5 min", tags: ["Freelancers"] },
  { slug: "vat-refund-audit-defense", number: "58", label: "Refunds", title: "VAT Refund & Audit Defense in Kenya - How to Win", bluf: "Navigate KRA VAT audits, survive the Special Table review, and recover excess input VAT within the 12-month refund window under Finance Act rules.", readTime: "7 min", tags: ["Refunds"] },
  { slug: "efris-lessons-pre-clearance", number: "59", label: "e-Invoicing", title: "Real-Time Pre-Clearance & E-Invoicing: Lessons from EFRIS", bluf: "What breaks in SME POS systems when tax authorities shift to real-time pre-clearance e-invoicing (like Uganda's EFRIS), and how to prepare.", readTime: "6 min", tags: ["e-Invoicing"] },
  { slug: "vat-2027-auto-filled-returns", number: "60", label: "Filing", title: "VAT 2027: KRA Pre-Filled Returns Are Coming - Prepare Now", bluf: "KRA's transition to pre-filled (auto-populated) VAT returns starting January 2027, and how eTIMS and iCMS data will assemble your return automatically.", readTime: "6 min", tags: ["Filing"] },
  { slug: "kra-portal-vs-service", number: "61", label: "Registration", title: "Register for VAT Yourself on iTax or Pay KES 5,000? The Honest Math", bluf: "An honest comparison of DIY VAT registration on KRA iTax vs hiring Smart VAT Kenya. Portal crashes, 14+ error codes, time cost, and penalty risk.", readTime: "6 min", tags: ["Registration"] },
  { slug: "vat-deadline-reminders", number: "62", label: "Deadlines", title: "Free KRA VAT Deadline Reminders on WhatsApp", bluf: "Never miss the 20th KRA VAT filing deadline again. Get automated WhatsApp reminders on the 17th of every month. Free service by Smart VAT Kenya.", readTime: "2 min", tags: ["Deadlines"] },
  { slug: "non-resident-rental-income-tax-kenya", number: "63", label: "Non-Resident Tax", title: "Non-Resident Rental Income Tax Kenya: 30% Withholding Guide (2026)", bluf: "Kenya now charges non-resident landlords a 30% final withholding tax on gross rental income under the Finance Act 2026. Who must register, deadlines, and penalties.", readTime: "7 min", tags: ["Non-Resident"] },
  { slug: "significant-economic-presence-tax-kenya", number: "64", label: "Digital Tax", title: "Significant Economic Presence (SEP) Tax Kenya: Who Pays 3% and How (2026)", bluf: "Kenya's SEP tax charges non-resident digital platforms an effective 3% of gross Kenyan revenue, with no minimum threshold. Who it hits and what it means for local freelancers and businesses.", readTime: "6 min", tags: ["Digital"] },
]

// Remove duplicates by slug
const uniquePillars = pillars.filter((p, i, arr) => arr.findIndex((x) => x.slug === p.slug) === i)
---

<BaseLayout title="Kenya VAT Knowledge Base & Guides" description="Free Kenya VAT knowledge base for SMEs: VAT registration on KRA iTax, 16% VAT calculation, nil returns, the 2026 tax amnesty, penalty waivers and eTIMS." path="/resources/">
  <main class="max-w-[1400px] mx-auto px-6 lg:px-10 pt-12 lg:pt-16 pb-20 lg:pb-24">
    <header class="mb-10">
      <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-brand mb-3">Knowledge Base</p>
      <h1 class="font-display text-[clamp(1.8rem,4vw,2.8rem)] font-semibold text-ink tracking-tight leading-tight mb-4 text-balance">
        Kenya VAT Knowledge Base
      </h1>
      <p class="text-[0.95rem] text-ink-muted leading-relaxed max-w-[56ch]">
        Free guides written for Kenyan SMEs. How to register for VAT, file returns, calculate 16% VAT, get a penalty waiver, compare Turnover Tax vs VAT, and understand eTIMS compliance. Updated for 2026.
      </p>
    </header>

    <h2 class="font-display text-xl font-semibold text-ink mb-6">All KRA VAT &amp; eTIMS Guides</h2>

    <ResourceSearch pillars={uniquePillars} client:visible />
  </main>
</BaseLayout>
