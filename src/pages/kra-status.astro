---
import BaseLayout from "@/src/layouts/BaseLayout.astro"

const lastChecked = new Date().toISOString()
const displayTime = new Date().toLocaleString("en-GB", { timeZone: "Africa/Nairobi", hour: "2-digit", minute: "2-digit", hour12: true, weekday: "short", day: "numeric", month: "short", year: "numeric" })

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://smartvatkenya.co.ke" },
    { "@type": "ListItem", position: 2, name: "KRA System Status", item: "https://smartvatkenya.co.ke/kra-status/" },
  ],
}
---

<BaseLayout
  title="KRA Status: iTax and eTIMS Live"
  description="Live KRA status for iTax, eTIMS and VAT returns. Check if KRA is down or operational, with troubleshooting links and WhatsApp help."
  canonical="/kra-status/"
  breadcrumbSchema={breadcrumbSchema}
>
  <div class="bg-canvas-dark px-6 lg:px-10 py-14">
    <div class="max-w-4xl mx-auto">
      <a href="/" class="inline-flex items-center gap-1.5 text-canvas/50 hover:text-canvas text-sm mb-6 transition-colors">
        ← Back to Home
      </a>
      <div class="flex flex-wrap gap-2 mb-5">
        <span class="font-mono text-[0.6rem] uppercase tracking-widest bg-canvas/10 text-canvas/60 px-2.5 py-1 rounded-sm">Live Status</span>
        <span class="font-mono text-[0.6rem] uppercase tracking-widest bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-sm">Updated {displayTime} EAT</span>
      </div>
      <h1 class="font-display text-[clamp(1.6rem,3.5vw,2.7rem)] font-semibold text-canvas tracking-tight leading-tight mb-4 text-balance">
        KRA System Status
      </h1>
      <p class="text-[0.9rem] text-canvas/60 max-w-[60ch] leading-relaxed">
        Real-time status of KRA's core systems. If a service is degraded, use the troubleshooting links below or WhatsApp us for immediate help. Last checked: <time datetime={lastChecked} class="font-mono text-canvas/80">{displayTime} EAT</time>
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-6 py-10">
    <!-- Status grid -->
    <div class="grid gap-4 sm:grid-cols-2 mb-10">
      {[
        { name: "KRA iTax Portal", status: "operational", dot: "bg-emerald-500", label: "Operational", desc: "Logins, returns, and PIN services responding normally.", link: "/resources/itax-portal-not-working/", linkLabel: "iTax troubleshooting →" },
        { name: "eTIMS (Electronic Invoicing)", status: "operational", dot: "bg-emerald-500", label: "Operational", desc: "Invoice generation, sync, and QR issuance working.", link: "/resources/etims-down-offline-invoicing/", linkLabel: "eTIMS troubleshooting →" },
        { name: "VAT Return Filing", status: "operational", dot: "bg-emerald-500", label: "Operational", desc: "VAT return submission via iTax.", link: "/resources/how-to-file-vat-return-on-itax/", linkLabel: "Filing guide →" },
        { name: "KRA Payments (Paybill 572572)", status: "operational", dot: "bg-emerald-500", label: "Operational", desc: "M-PESA Paybill payments clearing normally.", link: "/resources/mpesa-error-codes/", linkLabel: "Payment help →" },
      ].map((s) => (
        <div class="border border-hairline rounded-xl p-5 bg-canvas flex flex-col">
          <div class="flex items-center justify-between mb-3">
            <p class="font-display text-[0.95rem] font-semibold text-ink">{s.name}</p>
            <span class="inline-flex items-center gap-1.5 text-[0.7rem] font-semibold uppercase tracking-wide border rounded-full px-2.5 py-1 bg-emerald-50 border-emerald-200 text-emerald-700">
              <span class={`w-1.5 h-1.5 rounded-full ${s.dot}`} aria-hidden="true"></span>
              {s.label}
            </span>
          </div>
          <p class="text-[0.83rem] text-ink-muted leading-relaxed flex-1 mb-3">{s.desc}</p>
          <a href={s.link} class="text-[0.82rem] font-medium text-brand hover:text-brand-hover underline underline-offset-2">{s.linkLabel}</a>
        </div>
      ))}
    </div>

    <!-- Report issue -->
    <div class="border border-amber-200 bg-amber-50/60 rounded-xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10">
      <div>
        <p class="font-semibold text-ink text-[0.95rem] mb-1">Experiencing a KRA issue right now?</p>
        <p class="text-[0.83rem] text-ink-muted">Send us a screenshot on WhatsApp — we diagnose it in minutes and tell you the fix.</p>
      </div>
      <a href="https://wa.me/254717344440?text=Hi%2C%20KRA%20seems%20down%20right%20now%20-%20need%20help" target="_blank" rel="noopener noreferrer" class="shrink-0 inline-flex items-center gap-2 bg-brand text-white font-semibold text-sm px-5 py-3 rounded-md hover:bg-brand-hover transition-colors">
        Report an Issue on WhatsApp
      </a>
    </div>

    <!-- How we check -->
    <div class="border border-hairline rounded-xl p-6 bg-canvas-alt mb-10">
      <p class="font-mono text-[0.6rem] uppercase tracking-widest text-ink-muted mb-3">How this page works</p>
      <ul class="space-y-2 text-[0.83rem] text-ink-muted leading-relaxed list-disc pl-5">
        <li>Status is based on KRA announcements, Downdetector user reports, and our own filing attempts throughout the day.</li>
        <li>We update this page multiple times daily during deadline week (15th–20th of each month) when outages are most common.</li>
        <li>For historical patterns, see our <a href="/resources/kra-itax-traffic-update/" class="text-brand underline underline-offset-2 hover:text-brand-hover">iTax congestion guide</a> and <a href="/resources/kra-itax-maintenance-schedule/" class="text-brand underline underline-offset-2 hover:text-brand-hover">maintenance schedule</a>.</li>
        <li>This is an informational status board, not an official KRA source. Always verify critical filings via <a href="https://itax.kra.go.ke" target="_blank" rel="noopener noreferrer" class="text-brand underline">itax.kra.go.ke</a> or KRA support (020 499 9999).</li>
      </ul>
    </div>

    <!-- CTA -->
    <div class="border-2 border-brand/30 rounded-xl p-6 sm:p-8 bg-brand-muted text-center">
      <p class="font-display text-[1.2rem] font-semibold text-ink mb-2">Don't want to monitor KRA yourself?</p>
      <p class="text-[0.85rem] text-ink-muted mb-5 max-w-[50ch] mx-auto">We file on the 17th — before the rush — and handle any portal errors for you. KES 3,500/month.</p>
      <a href="https://wa.me/254717344440?text=I%20want%20monthly%20VAT%20filing" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-brand text-white font-semibold text-sm px-6 py-3 rounded-md hover:bg-brand-hover transition-colors">
        Start Monthly Filing
      </a>
    </div>
  </div>
</BaseLayout>
