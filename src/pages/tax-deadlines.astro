---
import BaseLayout from "@/src/layouts/BaseLayout.astro"

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://smartvatkenya.co.ke" },
    { "@type": "ListItem", position: 2, name: "Kenya VAT Filing Deadlines 2026", item: "https://smartvatkenya.co.ke/tax-deadlines/" },
  ],
}

// Deadlines are COMPUTED AT BUILD TIME (Africa/Nairobi) and re-computed
// client-side by /public/js/deadlines.js on every visit, so this page can
// never show a past date as "due soon" again (the previous hardcoded
// "20 September 2026" stayed live for days after it passed).
// Kenya has no DST: EAT is fixed UTC+3, so client recompute is exact.
function nairobiToday(now = new Date()) {
  return new Date(now.getTime() + 3 * 3600 * 1000)
}
function nextMonthly(now = new Date(), day = 20) {
  const n = nairobiToday(now)
  const y = n.getUTCFullYear(), m = n.getUTCMonth(), d = n.getUTCDate()
  if (d <= day) return new Date(Date.UTC(y, m, day))
  return new Date(Date.UTC(y, m + 1, day))
}
function fmtLong(d: Date) {
  return d.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
}
function fmtShort(d: Date) {
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
}
function prevPeriod(d: Date) {
  // The tax period a monthly deadline covers is the previous calendar month.
  return new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() - 1, 1)).toLocaleDateString("en-GB", { month: "long", year: "numeric", timeZone: "UTC" })
}
function daysUntil(d: Date, now = new Date()) {
  return Math.max(0, Math.ceil((d.getTime() - now.getTime()) / 86400000))
}

const now = new Date()
const next20 = nextMonthly(now, 20)
const next9 = nextMonthly(now, 9)
const vatUrgent = daysUntil(next20, now) <= 7
const calDate = next20.toISOString().slice(0, 10).replace(/-/g, "")
const calUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=KRA+VAT+Deadline&dates=${calDate}/${calDate}&details=VAT+return+due+via+iTax.+Pay+via+Paybill+572572&location=iTax+Portal`

const deadlines = [
  { name: "VAT Return & Payment", due: "20th of every month", day: 20, noteDynamic: true, note: (d: Date) => `For the ${prevPeriod(d)} tax period. File via iTax; pay via Paybill 572572.`, urgent: vatUrgent },
  { name: "PAYE (Pay As You Earn)", due: "9th of every month", day: 9, noteDynamic: true, note: (d: Date) => `For ${prevPeriod(d)} payroll. Withholding agents must remit via iTax.`, urgent: false },
  { name: "Withholding VAT", due: "20th of every month", day: 20, note: () => "Withholding VAT agents remit VAT deducted from suppliers.", urgent: false },
  { name: "Withholding Tax (General)", due: "20th of every month", day: 20, note: () => "Rent, professional fees, dividends - as applicable.", urgent: false },
  { name: "Turnover Tax (TOT)", due: "20th of every month", day: 20, note: () => "For small businesses under the TOT regime.", urgent: false },
  { name: "Excise Duty", due: "20th of every month", day: 20, note: () => "Manufacturers and licensed excise taxpayers.", urgent: false },
  { name: "Annual Income Tax (Individual)", due: "30 June annually", day: 0, next: "30 June 2027", note: () => "For the year ending 31 Dec 2026. Individual filers via iTax.", urgent: false },
  { name: "Annual Income Tax (Companies - Dec year-end)", due: "30 June annually", day: 0, next: "30 June 2027", note: () => "Companies with Dec year-end. Six months after year-end.", urgent: false },
  { name: "KRA Tax Amnesty Window Closes", due: "31 December 2026 (one-off)", day: 0, next: "31 December 2026", note: () => "Last day to qualify for 100% waiver of qualifying pre-2026 penalties, interest & fines.", urgent: true },
].map((d) => ({ ...d, next: d.next ?? fmtShort(d.day === 9 ? next9 : next20), date: d.day === 9 ? next9 : d.day === 20 ? next20 : null, note: d.note(d.day === 9 ? next9 : next20) }))
---

<BaseLayout
  title="Kenya VAT Filing Deadlines 2026: Full KRA Calendar"
  description="All KRA tax deadlines in one calendar — VAT, PAYE, TOT, and excise. Never miss the 20th again. Add each deadline to your calendar in one click."
  canonical="/tax-deadlines/"
  breadcrumbSchema={breadcrumbSchema}
>
  <div class="bg-canvas-dark px-6 lg:px-12 py-14">
    <div class="max-w-4xl mx-auto">
      <a href="/" class="inline-flex items-center gap-1.5 text-canvas/50 hover:text-canvas text-sm mb-6 transition-colors">
        ← Back to Home
      </a>
      <div class="flex flex-wrap gap-2 mb-5">
        <span class="font-mono text-[0.6rem] uppercase tracking-widest bg-canvas/10 text-canvas/60 px-2.5 py-1 rounded-sm">Calendar 2026</span>
        <span class="font-mono text-[0.6rem] uppercase tracking-widest bg-red-500/20 text-red-300 px-2.5 py-1 rounded-sm">Amnesty ends 31 Dec</span>
      </div>
      <h1 class="font-display text-[clamp(1.6rem,3.5vw,2.7rem)] font-semibold text-canvas tracking-tight leading-tight mb-4 text-balance">
        Kenya Tax Deadlines 2026: VAT, PAYE, TOT &amp; More
      </h1>
      <p class="text-[0.9rem] text-canvas/60 max-w-[60ch] leading-relaxed">
        Never miss the 20th again. All KRA deadlines in one place - add to Google Calendar or let us file on the 17th so you never pay the KES 10,000 late penalty.
      </p>

      <!-- Next deadline callout: time-sensitive urgency for deadline queries.
           Server renders build-time values; /public/js/deadlines.js refreshes
           them on every visit so the date is always in the future. -->
      <div class="mt-6 border border-canvas/15 rounded-lg bg-canvas/5 px-5 py-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="font-mono text-[0.6rem] uppercase tracking-widest bg-red-500/20 text-red-300 px-2.5 py-1 rounded-sm">Next deadline</span>
        <p class="text-[0.92rem] text-canvas/85">
          <strong class="text-canvas" data-deadline="vat-long">{fmtLong(next20)}</strong> — <span data-deadline="vat-callout">VAT return &amp; payment for the {prevPeriod(next20)} tax period</span>. File via iTax, pay via Paybill 572572.
        </p>
        <a data-track="calendar-add" data-cta-type="vat-deadline" data-deadline-href="vat" href={calUrl} target="_blank" rel="noopener noreferrer" class="text-[0.82rem] font-medium text-brand underline underline-offset-2 hover:text-brand-hover">Add to calendar →</a>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-6 py-10">
    <div class="border border-hairline rounded-xl overflow-hidden mb-8">
      <div class="overflow-x-auto">
        <table class="w-full text-[0.85rem]">
          <thead>
            <tr class="bg-canvas-alt border-b border-hairline">
              <th class="text-left p-3.5 font-semibold text-ink">Tax</th>
              <th class="text-left p-3.5 font-semibold text-ink">Due</th>
              <th class="text-left p-3.5 font-semibold text-ink">Next deadline</th>
              <th class="text-left p-3.5 font-semibold text-ink">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            {deadlines.map((d) => (
              <tr class={d.urgent ? "bg-red-50/40" : ""} data-deadline-row={d.day || undefined} data-urgent={String(d.urgent)}>
                <td class="p-3.5 font-medium text-ink">{d.name} {d.urgent && <span class="ml-1 inline-flex font-mono text-[0.6rem] uppercase tracking-wide bg-red-600 text-white px-1.5 py-0.5 rounded">Due soon</span>}</td>
                <td class="p-3.5 text-ink-muted whitespace-nowrap">{d.due}</td>
                <td class="p-3.5 text-ink font-mono text-[0.82rem] whitespace-nowrap" data-deadline={d.day ? `day-${d.day}` : undefined}>{d.next}</td>
                <td class="p-3.5 text-ink-muted text-[0.82rem] leading-snug max-w-[32ch]" data-deadline-note={d.noteDynamic ? `note-${d.day}` : undefined}>{d.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-3 mb-8">
      <div class="border border-hairline rounded-xl p-5 bg-canvas">
        <p class="font-display text-[0.95rem] font-semibold text-ink mb-1">Add to calendar</p>
        <p class="text-[0.82rem] text-ink-muted mb-3">Get a Google Calendar reminder for the 20th every month.</p>
        <a data-track="calendar-add" data-cta-type="vat-deadline" data-deadline-href="vat" href={calUrl} target="_blank" rel="noopener noreferrer" class="text-[0.82rem] font-medium text-brand underline underline-offset-2 hover:text-brand-hover">Add next VAT deadline →</a>
      </div>
      <div class="border border-hairline rounded-xl p-5 bg-canvas">
        <p class="font-display text-[0.95rem] font-semibold text-ink mb-1">Filing checklist</p>
        <p class="text-[0.82rem] text-ink-muted mb-3">Everything to double-check before you submit on iTax.</p>
        <a data-track="contact-cta" data-cta-type="filing-checklist" href="/resources/vat-return-filing-checklist/" class="text-[0.82rem] font-medium text-brand underline underline-offset-2 hover:text-brand-hover">See the checklist →</a>
      </div>
      <div class="border border-brand/20 rounded-xl p-5 bg-brand-muted">
        <p class="font-display text-[0.95rem] font-semibold text-ink mb-1">Let us file it</p>
        <p class="text-[0.82rem] text-ink-muted mb-3">KES 3,500/month. Filed on the 17th. No portal stress.</p>
        <a href="/services/monthly-vat-filing/" class="text-[0.82rem] font-medium text-brand underline underline-offset-2 hover:text-brand-hover">Start filing →</a>
      </div>
    </div>

    <div class="border border-hairline rounded-xl p-6 bg-canvas-alt">
      <p class="font-mono text-[0.6rem] uppercase tracking-widest text-ink-muted mb-3">Sources &amp; verification</p>
      <p class="text-[0.83rem] text-ink-muted leading-relaxed">
        Dates per KRA iTax guidance and the Tax Procedures Act. Next monthly deadlines are computed automatically (EAT) and refresh on every visit - last verified <time datetime="2026-09-27" class="font-mono">27 September 2026</time> against KRA. Tax amnesty deadline per KRA's 2026 Tax Amnesty Programme (penalties, interest &amp; fines on liabilities accrued up to 31 Dec 2025, window 1 Jul–31 Dec 2026; principal must be settled where due). Always confirm via <a href="https://www.kra.go.ke" target="_blank" rel="noopener noreferrer" class="text-brand underline">kra.go.ke</a> or 020 499 9999.
      </p>
    </div>
  </div>
  <script is:inline defer src="/js/deadlines.js"></script>
</BaseLayout>
