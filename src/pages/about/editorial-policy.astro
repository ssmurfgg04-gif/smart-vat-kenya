---
import BaseLayout from "@/src/layouts/BaseLayout.astro"
import EditorialPolicyPage from "@/src/components/pages/editorial-policy"

const breadcrumbSchema = {
  "@context": "https://schema.org" as const,
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://smartvatkenya.co.ke" },
    { "@type": "ListItem", position: 2, name: "About", item: "https://smartvatkenya.co.ke/about/" },
    { "@type": "ListItem", position: 3, name: "Editorial Policy", item: "https://smartvatkenya.co.ke/about/editorial-policy/" },
  ],
}
---

<BaseLayout
  title="Editorial Policy — How SmartVAT Verifies Every Kenya Tax Answer"
  description="How SmartVAT content is produced, verified against the VAT Act, Tax Procedures Act, Finance Act and KRA guidance, corrected and kept current. Our four-source verification standard."
  path="/about/editorial-policy/"
  breadcrumbSchema={breadcrumbSchema}
>
  <EditorialPolicyPage />
</BaseLayout>
