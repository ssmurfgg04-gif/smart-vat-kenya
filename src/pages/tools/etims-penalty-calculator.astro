---
import BaseLayout from "@/src/layouts/BaseLayout.astro"
import { EtimsPenaltyCalculator } from "@/src/components/pages/etims-penalty-calculator"
---

<BaseLayout
  title="eTIMS Penalty Calculator Kenya 2026 — Calculate Your KRA Exposure"
  description="Free eTIMS penalty calculator for Kenya. Estimate your KRA exposure: KES 50,000/month for eTIMS non-compliance, late-filing penalties, and KES 100,000 per non-compliant invoice."
  canonical="/tools/etims-penalty-calculator/"
>
  <div className="bg-canvas min-h-[100dvh]">
    <div className="bg-canvas-dark px-6 lg:px-10 py-16">
      <div className="max-w-[1400px] mx-auto">
        <p className="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-canvas/60 mb-4">Free tool — no sign-up required</p>
        <h1 className="font-display text-[clamp(2rem,4vw,3rem)] font-semibold text-canvas tracking-tight leading-tight mb-4 text-balance">
          eTIMS Penalty Calculator — What Is Non-Compliance Costing You?
        </h1>
        <p className="text-[0.95rem] text-canvas/70 max-w-[60ch] leading-relaxed">
          KRA charges KES 50,000 per month for eTIMS non-compliance, plus fines for late filing and non-compliant invoices. See your total exposure in seconds — then fix it before it grows.
        </p>
      </div>
    </div>

    <div className="max-w-[1400px] mx-auto px-6 lg:px-10 py-16">
      <div className="max-w-3xl">
        <EtimsPenaltyCalculator />
      </div>
    </div>
  </div>
</BaseLayout>
