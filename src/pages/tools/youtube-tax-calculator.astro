---
import BaseLayout from "@/src/layouts/BaseLayout.astro"
import YouTubeTaxCalculator from "@/src/components/pages/youtube-tax-calculator"
// WebApplication schema -> rich-result eligibility for the tool (audit Part 7)
const webAppSchema = {'@context': 'https://schema.org', '@type': 'WebApplication', 'name': 'Kenya YouTube Tax Calculator (5% Withholding)', 'applicationCategory': 'FinanceApplication', 'operatingSystem': 'Web', 'url': 'https://smartvatkenya.co.ke/tools/youtube-tax-calculator/', 'description': 'Enter monthly AdSense earnings to see the 5% Google withholding tax, take-home and annual totals for Kenyan creators. Free.', 'offers': {'@type': 'Offer', 'price': '0', 'priceCurrency': 'KES'}, 'publisher': {'@type': 'Organization', 'name': 'Smart VAT Kenya'}}


---

<BaseLayout
  jsonLd={webAppSchema}
  title="YouTube Tax Calculator Kenya: 5% Withholding"
  description="Free Kenya YouTube tax calculator: enter your monthly AdSense earnings and see the 5% Google withholding, what lands in your account, and your annual totals."
  canonical="/tools/youtube-tax-calculator/"
  keywords={["YouTube tax calculator Kenya", "5% withholding tax Kenya", "AdSense tax Kenya", "creator tax Kenya 2026"]}
>
  <YouTubeTaxCalculator client:load />
</BaseLayout>
