  },
  employee: {
    "@type": "Person",
    "@id": "https://smartvatkenya.co.ke/#tax-expert",
    name: "Certified Tax Experts",
    worksFor: { "@id": "https://smartvatkenya.co.ke/#organization" },
    knowsAbout: ["Kenya VAT Law", "KRA eTIMS", "Income Tax Act", "Tax Procedures Act"],
  },
  alumniOf: {
    "@type": "EducationalOrganization",
    name: "Kenya School of Revenue Administration (KESRA)",
  },
  award: "KRA Registered Tax Agent",
memberOf: {
    "@type": "Organization",
    name: "Institute of Certified Public Accountants of Kenya (ICPAK)",
  },
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": "https://smartvatkenya.co.ke/tools#app",
      name: "Free Kenya VAT Calculator 2026",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      description:
        "Calculate Kenya VAT at 16% standard rate, zero-rated (0%) or exempt. Includes KRA late-filing penalty estimator and 'Am I Required?' VAT registration check.",
      url: "https://smartvatkenya.co.ke/tools",
    },
    {
      "@type": "WebSite",
      "@id": "https://smartvatkenya.co.ke/#website",
      url: "https://smartvatkenya.co.ke",
      name: "Smart VAT Kenya",
      publisher: { "@id": "https://smartvatkenya.co.ke/#business" },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: "https://smartvatkenya.co.ke/resources?q={search_term_string}",
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Service",
      "@id": "https://smartvatkenya.co.ke/services#vat-filing-service",
      name: "Monthly VAT Filing Service",
      description:
        "Monthly iTax VAT return filing before the 20th KRA deadline. We file on the 17th. Includes deadline reminders and M-PESA payment guidance.",
      provider: { "@id": "https://smartvatkenya.co.ke/#business" },
      areaServed: { "@type": "Country", name: "Kenya" },
      serviceType: "VAT Filing",
    },
    {
