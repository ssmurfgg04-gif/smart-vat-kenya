  priceRange: "KES 3,500 - KES 5,000",
  currenciesAccepted: "KES",
  paymentAccepted: "M-PESA, Bank Transfer",
  foundingDate: "2024",
  numberOfEmployees: "10",
  founder: {
    "@type": "Person",
