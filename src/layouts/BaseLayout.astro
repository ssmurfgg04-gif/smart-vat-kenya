---
import "@/src/styles/globals.css"
import { Navbar } from "@/src/components/navbar"
import Footer from "@/src/components/Footer.astro"
import { BackToTop } from "@/components/back-to-top"

export interface Props {
  title?: string
  description?: string
  canonical?: string
  path?: string
  image?: string
  type?: "website" | "article"
  publishedTime?: string
  modifiedTime?: string
  keywords?: string[]
  jsonLd?: Record<string, unknown>
  breadcrumbSchema?: Record<string, unknown>
  articleSchema?: Record<string, unknown>
  author?: string
}

const SITE_URL = "https://smartvatkenya.co.ke"
const SITE_NAME = "Smart VAT Kenya"
const DEFAULT_OG = "/og-image.png"

const {
  title,
  description,
  canonical: canonicalProp,
  path,
  image = DEFAULT_OG,
  type = "website",
  publishedTime,
  modifiedTime,
  keywords,
  jsonLd,
  breadcrumbSchema,
  articleSchema,
  author = "Smart VAT Kenya Content Team",
} = Astro.props

const canonical = canonicalProp ?? path ?? "/"
if (!canonicalProp && !path) {
  console.warn(`[SEO] Page without canonical or path: ${Astro.url.pathname}`)
}
const canonicalClean = canonical.replace(/(?<!\/)$/, "/")
// CTR optimization: Google truncates titles around 60 characters.
// Append the brand suffix only when the combined title stays under that limit;
// long, intent-matched titles render untruncated in the SERP instead.
const pageTitle = title
  ? (title.length + SITE_NAME.length + 3 <= 60 ? `${title} | ${SITE_NAME}` : title)
  : "VAT Registration Services Kenya | KRA VAT Calculator | Smart VAT Kenya"
const pageDesc = description ?? "Professional VAT registration services in Kenya - KES 5,000 flat fee, done in 1-3 working days."
const pageUrl = `${SITE_URL}${canonicalClean}`
const imageUrl = image.startsWith("http") ? image : `${SITE_URL}${image}`
const socialTitle = pageTitle.includes(SITE_NAME)
  ? pageTitle
  : pageTitle.length + SITE_NAME.length + 3 <= 70
    ? `${pageTitle} | ${SITE_NAME}`
    : pageTitle

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://smartvatkenya.co.ke/#organization",
  name: "Smart VAT Kenya",
  alternateName: "Smart VAT Kenya",
  legalName: "Smart VAT Kenya Limited",
  description:
    "Professional VAT registration and monthly filing services for Kenyan SMEs. Flat-fee pricing, eTIMS-compliant, M-PESA accepted, email support. KRA-registered tax agents.",
  email: "info@smartvatkenya.co.ke",
  url: "https://smartvatkenya.co.ke",
  logo: {
    "@type": "ImageObject",
    url: "https://smartvatkenya.co.ke/icon.svg",
    width: 256,
    height: 256,
    caption: "Smart VAT Kenya Logo",
  },
  image: "https://smartvatkenya.co.ke/og-image.png",
