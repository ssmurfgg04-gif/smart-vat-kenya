---
import "@/src/styles/globals.css"
import { Navbar } from "@/src/components/navbar"
import Footer from "@/src/components/Footer.astro"
import { WhatsAppButton } from "@/components/whatsapp-button"
import { BackToTop } from "@/components/back-to-top"

export interface Props {
  title?: string
  description?: string
  canonical?: string
  path?: string
  image?: string
  type?: "website" | "article"
  publishedTime?: string
  modifiedTime?: string
  keywords?: string[]
  jsonLd?: Record<string, unknown>
  breadcrumbSchema?: Record<string, unknown>
  articleSchema?: Record<string, unknown>
  author?: string
}

const SITE_URL = "https://smartvatkenya.co.ke"
const SITE_NAME = "Smart VAT Kenya"
const DEFAULT_OG = "/og-image.png"

const {
  title,
  description,
  canonical: canonicalProp,
  path,
  image = DEFAULT_OG,
  type = "website",
  publishedTime,
  modifiedTime,
  keywords,
  jsonLd,
  breadcrumbSchema,
  articleSchema,
  author = "Smart VAT Kenya Content Team",
} = Astro.props

const canonical = canonicalProp ?? path ?? "/"
if (!canonicalProp && !path) {
  console.warn(`[SEO] Page without canonical or path: ${Astro.url.pathname}`)
}
const canonicalClean = canonical.replace(/(?<!\/)$/, "/")
// CTR optimization: Google truncates titles around 60 characters.
// Append the brand suffix only when the combined title stays under that limit;
// long, intent-matched titles render untruncated in the SERP instead.
const pageTitle = title
  ? (title.length + SITE_NAME.length + 3 <= 60 ? `${title} | ${SITE_NAME}` : title)
  : "VAT Registration Services Kenya | KRA VAT Calculator | Smart VAT Kenya"
const pageDesc = description ?? "Professional VAT registration services in Kenya - KES 5,000 flat fee, done in 1-3 working days."
const pageUrl = `${SITE_URL}${canonicalClean}`
const imageUrl = image.startsWith("http") ? image : `${SITE_URL}${image}`
const socialTitle = pageTitle.includes(SITE_NAME)
  ? pageTitle
  : pageTitle.length + SITE_NAME.length + 3 <= 70
    ? `${pageTitle} | ${SITE_NAME}`
    : pageTitle

// ENTITY GRAPH — rules that keep the knowledge graph clean:
// 1. sameAs may ONLY list pages that are ABOUT this entity (social profiles,
//     Wikidata). Government portals (kra.go.ke etc.) are SOURCE material, not
//     identity — listing them as sameAs told machines "SmartVAT Kenya IS KRA".
// 2. Every @id cross-reference must resolve. (The old "#business" refs dangled;
//     the org is #organization.)
// 3. No fabricated ratings. Self-serving AggregateRating on your own org is
//     ignored by Google and is a manual-action liability. Trust comes from
//     verifiable signals instead (publishingPrinciples, real contacts, data).
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://smartvatkenya.co.ke/#organization",
  name: "Smart VAT Kenya",
  alternateName: ["SmartVAT Kenya", "Smart VAT Kenya Limited"],
  legalName: "Smart VAT Kenya Limited",
  disambiguatingDescription:
    "Smart VAT Kenya is a Kenyan tax-services firm and publisher of practical Kenya VAT guidance, calculators and statistics — distinct from unrelated European VAT-compliance software brands using similar names.",
  description:
    "Professional VAT registration and monthly filing services for Kenyan SMEs. Flat-fee pricing, eTIMS-compliant, M-PESA accepted, WhatsApp support. Publishes Kenya's most-cited practical VAT reference library, calculators and open tax datasets.",
  email: "info@smartvatkenya.co.ke",
  telephone: "+254705467108",
  url: "https://smartvatkenya.co.ke",
  logo: {
    "@type": "ImageObject",
    url: "https://smartvatkenya.co.ke/icon.svg",
    width: 256,
    height: 256,
    caption: "Smart VAT Kenya Logo",
  },
  image: "https://smartvatkenya.co.ke/og-image.png",
  slogan: "Kenya VAT, handled. Registered, filed, compliant — by the 17th.",
  // Identity links ONLY (pages about this entity). Once the Wikidata item is
  // live, add it here — see docs/backlink-playbook.md (Wikidata section).
  sameAs: [
    "https://www.linkedin.com/company/smart-vat-kenya",
    "https://www.twitter.com/smartvatkenya",
    "https://www.facebook.com/smartvatkenya",
  ],
  // Primary-source relationships (instead of broken sameAs): what we interpret.
  subjectOf: [
    "https://smartvatkenya.co.ke/sources/",
    "https://smartvatkenya.co.ke/statistics/",
  ],
  publishingPrinciples: "https://smartvatkenya.co.ke/about/editorial-policy/",
  knowsAbout: [
    "Kenya VAT Registration",
    "KRA VAT Filing",
    "Kenya eTIMS",
    "KRA Penalty Waiver",
    "Tax Compliance Certificate",
    "VAT Compliance Kenya",
    "Kenya Tax Procedures Act",
    "Kenya VAT Act",
    "Kenya Finance Act",
    "VAT refunds Kenya",
    "Turnover Tax Kenya",
    "Digital service tax Kenya",
  ],
  knowsLanguage: ["English", "Swahili"],
  areaServed: { "@type": "Country", name: "Kenya" },
  priceRange: "KES 3,500 - KES 5,000",
  currenciesAccepted: "KES",
  paymentAccepted: "M-PESA, Bank Transfer",
  foundingDate: "2024",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Pioneer House, Moi Avenue",
    addressLocality: "Nairobi",
    addressRegion: "Nairobi County",
    postalCode: "00100",
    addressCountry: "KE",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -1.2921,
    longitude: 36.8219,
  },
  hasMap: "https://maps.google.com/?q=Pioneer+House+Moi+Avenue+Nairobi",
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+254705467108",
    email: "info@smartvatkenya.co.ke",
    contactType: "customer service",
    availableLanguage: ["English", "Swahili"],
    areaServed: "KE",
    hoursAvailable: "Mo-Fr 08:00-18:00",
  },
  founder: {
    "@type": "Person",
    "@id": "https://smartvatkenya.co.ke/#founder",
    name: "Smart VAT Kenya Team",
  },
  employee: {
    "@type": "Person",
    "@id": "https://smartvatkenya.co.ke/#tax-expert",
    name: "Certified Tax Experts",
    worksFor: { "@id": "https://smartvatkenya.co.ke/#organization" },
    knowsAbout: ["Kenya VAT Law", "KRA eTIMS", "Income Tax Act", "Tax Procedures Act"],
  },
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://smartvatkenya.co.ke/#website",
      url: "https://smartvatkenya.co.ke",
      name: "Smart VAT Kenya",
      alternateName: "SmartVAT Kenya",
      description:
        "Practical Kenya VAT and KRA compliance guides, calculators, statistics and filing services for Kenyan SMEs.",
      publisher: { "@id": "https://smartvatkenya.co.ke/#organization" },
      inLanguage: "en-KE",
      copyrightHolder: { "@id": "https://smartvatkenya.co.ke/#organization" },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: "https://smartvatkenya.co.ke/resources?q={search_term_string}",
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "WebPage",
      "@id": "https://smartvatkenya.co.ke/sources/#law-library",
      url: "https://smartvatkenya.co.ke/sources/",
      name: "Kenya Tax Law Library — Primary Sources Behind Every SmartVAT Answer",
      isPartOf: { "@id": "https://smartvatkenya.co.ke/#website" },
      about: { "@id": "https://smartvatkenya.co.ke/#organization" },
      description:
        "Every SmartVAT claim mapped to the section of the VAT Act, Tax Procedures Act, Finance Act or KRA regulation it comes from.",
    },
    {
      "@type": "Service",
      "@id": "https://smartvatkenya.co.ke/services#vat-filing-service",
      name: "Monthly VAT Filing Service",
      description:
        "Monthly iTax VAT return filing before the 20th KRA deadline. We file on the 17th. Includes deadline reminders and M-PESA payment guidance.",
      provider: { "@id": "https://smartvatkenya.co.ke/#organization" },
      areaServed: { "@type": "Country", name: "Kenya" },
      serviceType: "VAT Filing",
    },
    {
      "@type": "Service",
      "@id": "https://smartvatkenya.co.ke/services#registration",
      name: "VAT Registration",
      serviceType: "VAT Registration",
      description:
        "Complete VAT registration via KRA iTax portal. Includes profile update, VAT Form 1, PIN generation, eTIMS onboarding guidance, and taxpayer education.",
      provider: { "@id": "https://smartvatkenya.co.ke/#organization" },
      areaServed: { "@type": "Country", name: "Kenya" },
    },
    {
      "@type": "Service",
      "@id": "https://smartvatkenya.co.ke/services#filing",
      name: "Monthly VAT Filing Kenya",
      serviceType: "VAT Filing",
      description:
        "Monthly iTax VAT return filing before the 20th KRA deadline. We file on the 17th. Avoids KES 10,000 late-filing penalty.",
      provider: { "@id": "https://smartvatkenya.co.ke/#organization" },
      areaServed: { "@type": "Country", name: "Kenya" },
    },
  ],
};

// Author entity — real, reviewable editorial accountability.
const authorSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://smartvatkenya.co.ke/#author",
  name: "Smart VAT Kenya Editorial Team",
  url: "https://smartvatkenya.co.ke/about/editorial-policy/",
  worksFor: { "@id": "https://smartvatkenya.co.ke/#organization" },
  description:
    "Kenya tax content editorial team. Every guide is verified against the VAT Act (Cap. 476), the Tax Procedures Act (Cap. 469), the current Finance Act and KRA official guidance before publication, and re-verified each Finance Act season. Editorial standards and corrections policy: /about/editorial-policy/.",
  knowsAbout: [
    "Kenya VAT Law",
    "KRA eTIMS",
    "Income Tax Act",
    "Tax Procedures Act",
    "VAT Compliance",
    "eTIMS Onboarding",
  ],
  knowsLanguage: ["English", "Swahili"],
  parentOrganization: { "@id": "https://smartvatkenya.co.ke/#organization" },
};

// Repurpose the old citation block to point at the law library hub.
const citationSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://smartvatkenya.co.ke/sources/#law-library",
  url: "https://smartvatkenya.co.ke/sources/",
  name: "Kenya Tax Law Library & Official Sources",
  description:
    "Primary sources for every claim on Smart VAT Kenya: VAT Act (Cap. 476), Tax Procedures Act (Cap. 469), Finance Acts 2024-2026, eTIMS Regulations, VAT (Digital Marketplace) Regulations 2023, KRA practice notes and Kenya Gazette notices.",
  isPartOf: { "@id": "https://smartvatkenya.co.ke/#website" },
  publisher: { "@id": "https://smartvatkenya.co.ke/#organization" },
  about: [
    "Kenya Value Added Tax Act, 2013 (Cap. 476)",
    "Kenya Tax Procedures Act, 2015 (Cap. 469)",
    "Kenya Finance Act 2024",
    "Kenya Finance Act 2025",
    "Kenya Finance Act 2026",
    "VAT (Electronic, Internet and Digital Marketplace Supply) Regulations, 2023",
    "KRA eTIMS Regulations",
    "KRA Tax Procedures (Tax Amnesty) Regulations 2026",
  ],
};
---

<!doctype html>
<html lang="en-KE" class="bg-background">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#faf8f3" />
  
  <!-- Prevent flash of wrong theme -->
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('theme');
      if (stored === 'dark') {
        document.documentElement.classList.add('dark');
        const metaTheme = document.querySelector('meta[name="theme-color"]');
        if (metaTheme) metaTheme.setAttribute('content', '#0d1218');
      }
    })();
  </script>

  <!-- Analytics: GA4 (G-M3LZ5ED02B) + Microsoft Clarity (yn7r51pk7o).
       Same-origin init files (public/js/) so CSP stays hash-free for these;
       tag libraries allowed via script-src in astro.config.mjs.
       Events pushed by the delegated CTA tracker below + src/lib/analytics.ts. -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-M3LZ5ED02B"></script>
  <script is:inline defer src="/js/analytics-ga4.js"></script>
  <script is:inline defer src="/js/analytics-clarity.js"></script>

  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta name="author" content={author} />
  <meta name="article:author" content={author} />
  <link rel="canonical" href={pageUrl} />

  {keywords && keywords.length > 0 && (
    <meta name="keywords" content={keywords.join(", ")} />
  )}

  <!-- OG -->
  <meta property="og:title" content={socialTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="en_KE" />
  <meta property="og:type" content={type === "article" ? "article" : "website"} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={socialTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={imageUrl} />

  <!-- Hreflang (self-referencing per page; single-locale site) -->
  <link rel="alternate" hreflang="en-KE" href={pageUrl} />
  <link rel="alternate" hreflang="x-default" href={pageUrl} />
  <link rel="alternate" type="application/rss+xml" title="SmartVAT Kenya — Kenya VAT & KRA Compliance" href={`${SITE_URL}/rss.xml`} />

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Fonts - optimized loading with fallback for no-JS and better mobile experience -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Outfit:wght@400;500;600;700&display=swap" />

  <!-- Speculation Rules -->
  <script type="speculationrules" set:html={JSON.stringify({
    prefetch: [
      {
        source: "list",
        urls: ["/tools/", "/resources/", "/services/", "/resources/how-to-register-for-vat-in-kenya/", "/resources/kra-penalty-for-late-vat-filing/", "/resources/how-to-calculate-vat-in-kenya/", "/resources/cetis-kenya-2027/", "/resources/kra-tax-amnesty-2026/", "/resources/faq/"],
        requires: ["anonymous-client-ip-when-cross-origin"],
      },
    ],
  })} />

  <!-- Inline critical CSS -->
  <style>
    .bg-canvas-dark { background-color: var(--canvas-dark); }
    .bg-canvas { background-color: var(--canvas); }
    .text-canvas { color: var(--foreground); }
    .text-canvas\/80 { color: var(--foreground); opacity: 0.8; }
    .text-canvas\/65 { color: var(--foreground); opacity: 0.65; }
    .text-canvas\/70 { color: var(--foreground); opacity: 0.7; }
    .text-canvas\/60 { color: var(--foreground); opacity: 0.6; }
    .text-brand { color: var(--brand); }
    .text-ink { color: var(--ink); }
    .border-canvas\/25 { border-color: rgba(250, 248, 243, 0.25); }
    .border-canvas\/15 { border-color: rgba(250, 248, 243, 0.15); }
    .font-semibold { font-weight: 600; }
    .font-mono { font-family: ui-monospace, SF Mono, Cascadia Code, Fira Mono, monospace; }
    .tracking-tight { letter-spacing: -0.025em; }
    .text-balance { text-wrap: balance; }
    .text-pretty { text-wrap: pretty; }
    .overflow-hidden { overflow: hidden; }
    .relative { position: relative; }
    .absolute { position: absolute; }
    .inset-0 { inset: 0; }
    .pointer-events-none { pointer-events: none; }
    .z-0 { z-index: 0; }
    .z-10 { z-index: 10; }
    .z-50 { z-index: 50; }
    .max-w-\[52ch\] { max-width: 52ch; }
    .max-w-\[1400px\] { max-width: 1400px; }
    .mx-auto { margin-inline: auto; }
    .px-6 { padding-inline: 1.5rem; }
    .pt-12 { padding-top: 3rem; }
    .pb-20 { padding-bottom: 5rem; }
    .gap-12 { gap: 3rem; }
    .items-start { align-items: flex-start; }
    .leading-\[1\.05\] { line-height: 1.05; }
    .leading-relaxed { line-height: 1.625; }
    .mb-6 { margin-bottom: 1.5rem; }
    .mb-10 { margin-bottom: 2.5rem; }
    .self-start { align-self: flex-start; }
    @media (min-width: 1024px) {
      .lg\:grid-cols-\[1fr_420px\] { grid-template-columns: 1fr 420px; }
      .lg\:gap-20 { gap: 5rem; }
      .lg\:px-10 { padding-inline: 2.5rem; }
      .lg\:pt-16 { padding-top: 4rem; }
      .lg\:pb-24 { padding-bottom: 6rem; }
    }
  </style>

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(authorSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(citationSchema)} />
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <slot name="head" />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/icon.svg" />
  <link rel="alternate icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-icon.webp" />
</head>
<body class="antialiased font-sans text-ink bg-canvas">
  <noscript>
    <div class="bg-amber-50 border-b border-amber-200 px-4 py-2.5 text-center text-[0.78rem] text-amber-800 leading-snug">
      Smart VAT Kenya uses JavaScript for interactive tools (VAT calculator, penalty estimator) and search. For the best experience, please enable JavaScript in your browser.
    </div>
  </noscript>
  <Navbar client:load />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <BackToTop client:visible />
  <WhatsAppButton client:load />
  <script is:inline>
    // Unified delegated conversion tracking. Fires into every analytics layer
    // that may be present (GA4 dataLayer/gtag, Microsoft Clarity) and is
    // silent when none are loaded.
    (function () {
      function push(event, params) {
        try {
          var payload = Object.assign({ event: event, page: location.pathname }, params || {})
          if (Array.isArray(window.dataLayer)) window.dataLayer.push(payload)
          if (typeof window.gtag === "function") window.gtag("event", event, params || {})
          if (typeof window.clarity === "function") window.clarity("event", event)
        } catch (e) { /* never break the page */ }
      }
      document.addEventListener("click", function (e) {
        var el = e.target.closest("[data-track]")
        if (el) {
          var t = el.getAttribute("data-track")
          if (t === "wa-cta") {
            push("whatsapp_click", {
              cta_type: el.getAttribute("data-cta-type") || "unknown",
              service: el.getAttribute("data-service") || "general",
              href: el.getAttribute("href") || "",
            })
          } else if (t === "calculator-used" || t === "service-cta" || t === "calendar-add" || t === "contact-cta") {
            push(t, {
              cta_type: el.getAttribute("data-cta-type") || t,
              service: el.getAttribute("data-service") || "general",
              href: el.getAttribute("href") || "",
            })
          }
          return
        }
        var mail = e.target.closest('a[href^="mailto:"]')
        if (mail) push("contact_click", { cta_type: "email", service: "general", href: mail.getAttribute("href") || "" })
      }, { passive: true })
    })()
  </script>
</body>
</html>
