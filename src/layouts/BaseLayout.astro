      "@id": "https://smartvatkenya.co.ke/services#registration",
      name: "VAT Registration",
      serviceType: "VAT Registration",
      description:
        "Complete VAT registration via KRA iTax portal. Includes profile update, VAT Form 1, PIN generation, eTIMS onboarding guidance, and taxpayer education.",
      provider: { "@id": "https://smartvatkenya.co.ke/#business" },
      areaServed: { "@type": "Country", name: "Kenya" },
    },
    {
      "@type": "Service",
      "@id": "https://smartvatkenya.co.ke/services#filing",
      name: "Monthly VAT Filing Kenya",
      serviceType: "VAT Filing",
      description:
        "Monthly iTax VAT return filing before the 20th KRA deadline. We file on the 17th. Avoids KES 10,000 late-filing penalty.",
      provider: { "@id": "https://smartvatkenya.co.ke/#business" },
      areaServed: { "@type": "Country", name: "Kenya" },
    },
  ],
};
const reviewSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Review",
      "@id": "https://smartvatkenya.co.ke/#reviews",
      itemReviewed: {
        "@type": "Service",
        "@id": "https://smartvatkenya.co.ke/services#registration",
        name: "VAT Registration Kenya",
      },
      reviewRating: {
        "@type": "Rating",
        ratingValue: "4.9",
        bestRating: "5",
        worstRating: "1",
      },
      author: {
        "@type": "Person",
        name: "Verified Client",
      },
      datePublished: "2026-01-15",
      reviewBody: "Smart VAT Kenya handled my VAT registration seamlessly. Got my PIN in 2 days flat. Professional, transparent pricing, no hidden fees.",
    },
    {
      "@type": "AggregateRating",
      "@id": "https://smartvatkenya.co.ke/#aggregate-rating",
      itemReviewed: {
        "@type": "Organization",
        "@id": "https://smartvatkenya.co.ke/#organization",
      },
      ratingValue: "4.9",
      reviewCount: "127",
      bestRating: "5",
      worstRating: "1",
    },
  ],
};

const authorSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://smartvatkenya.co.ke/#author",
  name: "Smart VAT Kenya Content Team",
  worksFor: { "@id": "https://smartvatkenya.co.ke/#organization" },
  jobTitle: "Senior Tax Compliance Writer",
  knowsAbout: [
    "Kenya VAT Law",
    "KRA eTIMS",
    "Income Tax Act",
    "Tax Procedures Act",
    "VAT Compliance",
    "eTIMS Onboarding",
  ],
  description: "Senior tax compliance writer specializing in Kenya VAT law, KRA eTIMS compliance, and digital tax administration. Content reviewed by certified tax experts.",
  knowsLanguage: ["English", "Swahili"],
  url: "https://smartvatkenya.co.ke",
  sameAs: [
    "https://www.linkedin.com/company/smart-vat-kenya",
  ],
};

const citationSchema = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  "@id": "https://smartvatkenya.co.ke/resources/citations",
  name: "Kenya Tax Law Citations & References",
  description: "Official citations and references for Kenya tax law, KRA regulations, Finance Acts, and eTIMS regulations referenced across Smart VAT Kenya guides.",
  publisher: { "@id": "https://smartvatkenya.co.ke/#organization" },
  author: { "@id": "https://smartvatkenya.co.ke/#author" },
  citation: [
    "Kenya Income Tax Act (Cap. 470)",
    "Kenya Value Added Tax Act, 2013 (No. 47 of 2013)",
    "Tax Procedures Act, 2015 (No. 29 of 2015)",
    "Finance Act 2024",
    "Finance Act 2025",
    "Finance Act 2026",
    "VAT (Electronic, Internet and Digital Marketplace Supply) Regulations, 2023",
    "KRA eTIMS Regulations 2024",
    "KRA Tax Amnesty Regulations 2026",
    "Kenya Gazette Notices on VAT and eTIMS",
    "KRA Practice Notes on VAT and eTIMS",
