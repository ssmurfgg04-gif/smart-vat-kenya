---

<!doctype html>
<html lang="en-KE" class="bg-background">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#faf8f3" />
  
  <!-- Prevent flash of wrong theme -->
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('theme');
      if (stored === 'dark') {
        document.documentElement.classList.add('dark');
        const metaTheme = document.querySelector('meta[name="theme-color"]');
        if (metaTheme) metaTheme.setAttribute('content', '#0d1218');
      }
    })();
  </script>

  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta name="author" content={author} />
  <meta name="article:author" content={author} />
  <link rel="canonical" href={pageUrl} />

  {keywords && keywords.length > 0 && (
    <meta name="keywords" content={keywords.join(", ")} />
  )}

  <!-- OG -->
  <meta property="og:title" content={socialTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="en_KE" />
  <meta property="og:type" content={type === "article" ? "article" : "website"} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={socialTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={imageUrl} />

  <!-- Hreflang -->
  <link rel="alternate" hreflang="en-KE" href="https://smartvatkenya.co.ke" />
  <link rel="alternate" hreflang="x-default" href="https://smartvatkenya.co.ke" />

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Fonts - optimized loading with fallback for no-JS and better mobile experience -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Outfit:wght@400;500;600;700&display=swap" />

  <!-- Speculation Rules -->
  <script type="speculationrules">
    {JSON.stringify({
      prefetch: [
        {
          source: "list",
          urls: ["/tools", "/resources", "/services", "/resources/how-to-register-for-vat-in-kenya", "/resources/kra-penalty-for-late-vat-filing", "/resources/how-to-calculate-vat-in-kenya", "/resources/cetis-kenya-2027/", "/resources/kra-tax-amnesty-2026/", "/resources/faq/"],
          requires: ["anonymous-client-ip-when-cross-origin"],
        },
      ],
    })}
  </script>

  <!-- Inline critical CSS -->
  <style>
    .bg-canvas-dark { background-color: var(--canvas-dark); }
    .bg-canvas { background-color: var(--canvas); }
    .text-canvas { color: var(--foreground); }
    .text-canvas\/80 { color: var(--foreground); opacity: 0.8; }
    .text-canvas\/65 { color: var(--foreground); opacity: 0.65; }
    .text-canvas\/70 { color: var(--foreground); opacity: 0.7; }
    .text-canvas\/60 { color: var(--foreground); opacity: 0.6; }
    .text-brand { color: var(--brand); }
    .text-ink { color: var(--ink); }
    .border-canvas\/25 { border-color: rgba(250, 248, 243, 0.25); }
    .border-canvas\/15 { border-color: rgba(250, 248, 243, 0.15); }
    .font-semibold { font-weight: 600; }
    .font-mono { font-family: ui-monospace, SF Mono, Cascadia Code, Fira Mono, monospace; }
    .tracking-tight { letter-spacing: -0.025em; }
    .text-balance { text-wrap: balance; }
    .text-pretty { text-wrap: pretty; }
    .overflow-hidden { overflow: hidden; }
    .relative { position: relative; }
    .absolute { position: absolute; }
    .inset-0 { inset: 0; }
    .pointer-events-none { pointer-events: none; }
    .z-0 { z-index: 0; }
    .z-10 { z-index: 10; }
    .z-50 { z-index: 50; }
    .max-w-\[52ch\] { max-width: 52ch; }
    .max-w-\[1400px\] { max-width: 1400px; }
    .mx-auto { margin-inline: auto; }
    .px-6 { padding-inline: 1.5rem; }
    .pt-12 { padding-top: 3rem; }
    .pb-20 { padding-bottom: 5rem; }
    .gap-12 { gap: 3rem; }
    .items-start { align-items: flex-start; }
    .leading-\[1\.05\] { line-height: 1.05; }
    .leading-relaxed { line-height: 1.625; }
    .mb-6 { margin-bottom: 1.5rem; }
    .mb-10 { margin-bottom: 2.5rem; }
    .self-start { align-self: flex-start; }
    @media (min-width: 1024px) {
      .lg\:grid-cols-\[1fr_420px\] { grid-template-columns: 1fr 420px; }
      .lg\:gap-20 { gap: 5rem; }
      .lg\:px-10 { padding-inline: 2.5rem; }
      .lg\:pt-16 { padding-top: 4rem; }
      .lg\:pb-24 { padding-bottom: 6rem; }
    }
  </style>

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(authorSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(citationSchema)} />
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <slot name="head" />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/icon.svg" />
  <link rel="alternate icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-icon.webp" />
</head>
<body class="antialiased font-sans text-ink bg-canvas">
  <noscript>
    <div class="bg-amber-50 border-b border-amber-200 px-4 py-2.5 text-center text-[0.78rem] text-amber-800 leading-snug">
      Smart VAT Kenya uses JavaScript for interactive tools (VAT calculator, penalty estimator) and search. For the best experience, please enable JavaScript in your browser.
    </div>
  </noscript>
  <Navbar client:load />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <BackToTop client:load />
  <script is:inline>
    document.addEventListener('click', function(e){
      var a = e.target.closest('a[data-track="contact-cta"],a[href^="mailto:"]');
      if(!a) return;
      var cta = a.getAttribute('data-cta-type') || a.getAttribute('data-track') || 'contact';
      var service = a.getAttribute('data-service') || 'general';
      var href = a.getAttribute('href') || '';
      var payload = {event:'contact_click', cta_type: cta, service: service, page: location.pathname, href: href};
      if(window.dataLayer) window.dataLayer.push(payload);
      if(window.gtag) window.gtag('event','contact_click',{cta_type: cta, service: service, page_path: location.pathname});
      // track other key actions
      var calc = e.target.closest('[data-track="calculator-used"]');
      if(calc && window.dataLayer) window.dataLayer.push({event:'calculator_used', page: location.pathname});
    });
    // track calculator usage, service CTA, calendar add via data-track
    document.addEventListener('click', function(e){
      var t = e.target.closest('[data-track]');
      if(!t) return;
      var track = t.getAttribute('data-track');
      if(track==='calculator-used' || track==='service-cta' || track==='calendar-add'){
        var p={event: track, page: location.pathname, cta: t.getAttribute('data-cta-type')||track};
        if(window.dataLayer) window.dataLayer.push(p);
        if(window.gtag) window.gtag('event', track, {page_path: location.pathname});
      }
    });
  </script>
</body>
</html>
