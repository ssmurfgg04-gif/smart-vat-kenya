---
const year = new Date().getFullYear()

const footerSections = {
  services: [
    { href: "/services/vat-registration/", label: "VAT Registration" },
    { href: "/services/monthly-vat-filing/", label: "Monthly VAT Filing" },
    { href: "/services/etims-onboarding/", label: "eTIMS Onboarding" },
    { href: "/services/kra-penalty-waiver/", label: "Tax Amnesty & Penalty Waiver" },
  ],
  tools: [
    { href: "/tools/vat-calculator/", label: "VAT Calculator" },
    { href: "/tools/kra-penalty-calculator/", label: "KRA Penalty Calculator" },
    { href: "/tools/etims-penalty-calculator/", label: "eTIMS Penalty Calculator" },
    { href: "/tools/pin-checker/", label: "KRA PIN Checker" },
    { href: "/tax-deadlines/", label: "Tax Deadline Calendar" },
  ],
  help: [
    { href: "/kra-doctor/", label: "KRA Doctor - Problem Diagnosis" },
    { href: "/kra-updates/", label: "KRA Updates & Alerts" },
    { href: "/kra-status/", label: "KRA System Status" },
    { href: "/resources/", label: "Knowledge Base" },
    { href: "/resources/faq/", label: "VAT FAQ" },
    { href: "/sources/", label: "Kenya Tax Law Library" },
  ],
  data: [
    { href: "/statistics/", label: "Kenya Tax Statistics (Open Data)" },
    { href: "/tax-deadlines/", label: "2026 Deadline Calendar" },
    { href: "/tools/embed/", label: "Embed Our Calculators" },
    { href: "/open-source/", label: "Open Source (npm: vatkenya)" },
    { href: "/forms/", label: "Official KRA Forms Library" },
  ],
  company: [
    { href: "/about/", label: "About Us" },
    { href: "/about/editorial-policy/", label: "Editorial Policy" },
    { href: "/how-it-works/", label: "How It Works" },
    { href: "/partners/", label: "Partner Program" },
    { href: "/forms/", label: "Free Forms" },
    { href: "/privacy-policy/", label: "Privacy Policy" },
  ],
}
const trustItems = [
  "KRA-Compliant VAT Services",
  "200+ Businesses Supported",
  "On-Time Filing by the 17th",
  "eTIMS Onboarding Included",
  "M-PESA Payment Records Provided",
  "Email Support - Real Replies",
]
---
<footer class="bg-canvas-dark border-t border-canvas/10">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr_1fr] gap-12">
      <div class="lg:col-span-1">
        <a href="/" class="font-display text-[1.1rem] font-semibold text-canvas tracking-tight mb-4 inline-block hover:text-canvas/80 transition-colors" aria-label="Smart VAT Kenya - Home">
          Smart<span class="text-brand-on-dark">VAT</span>
          <span class="text-canvas/50 font-normal text-sm ml-1">Kenya</span>
        </a>
        <p class="text-[0.85rem] text-gray-300 leading-relaxed max-w-[30ch] mt-4 mb-6">
          Professional VAT registration services in Kenya and monthly iTax filing for SMEs.
          Flat-fee pricing. M-PESA accepted. Kenya VAT rate: 16% (2026).
        </p>
        <div class="space-y-2.5">
          <a href="/wa/" target="_blank" rel="noopener noreferrer" data-track="wa-cta" data-cta-type="footer" data-service="general" class="flex items-center gap-2.5 text-[0.82rem] text-gray-300 hover:text-canvas transition-colors">
            <svg viewBox="0 0 32 32" class="w-3.5 h-3.5 shrink-0 fill-current" aria-hidden="true"><path d="M16.003 2C8.28 2 2 8.28 2 16.003c0 2.47.645 4.79 1.77 6.81L2 30l7.38-1.74A13.95 13.95 0 0 0 16.003 30C23.72 30 30 23.72 30 16.003 30 8.28 23.72 2 16.003 2zm6.37 16.93c-.35-.18-2.07-1.02-2.39-1.13-.32-.12-.56-.18-.79.17-.24.35-.9 1.13-1.1 1.37-.2.24-.41.27-.76.09-.35-.18-1.47-.54-2.8-1.73-1.04-.93-1.74-2.07-1.94-2.42-.2-.35-.02-.54.15-.71.16-.16.35-.41.52-.62.18-.2.24-.35.35-.59.12-.24.06-.44-.03-.62-.09-.18-.79-1.9-1.08-2.6-.28-.68-.57-.59-.79-.6l-.67-.01c-.24 0-.62.09-.94.44-.32.35-1.23 1.2-1.23 2.93 0 1.73 1.26 3.4 1.44 3.63.18.24 2.48 3.79 6.01 5.31.84.36 1.5.58 2.01.74.85.27 1.62.23 2.23.14.68-.1 2.07-.85 2.37-1.67.29-.82.29-1.52.2-1.67-.08-.14-.32-.23-.67-.41z"/></svg>
            WhatsApp: 0705 467 108
          </a>
          <a href="mailto:info@smartvatkenya.co.ke" class="flex items-center gap-2.5 text-[0.82rem] text-gray-300 hover:text-canvas transition-colors">
            <svg viewBox="0 0 13 13" class="w-3 h-3 shrink-0 fill-current" aria-hidden="true"><path d="M12 2H1c-.6 0-1 .4-1 1v7c0 .6.4 1 1 1h11c.6 0 1-.4 1-1V3c0-.6-.4-1-1-1zm-1 2.5v5.5H2V4.5l4.5 2.5L11 4.5z"/></svg>
            info@smartvatkenya.co.ke
          </a>
          <p class="flex items-start gap-2.5 text-[0.75rem] text-gray-400 leading-snug max-w-[28ch]">
            <svg viewBox="0 0 12 12" class="w-3 h-3 shrink-0 mt-0.5 fill-current text-canvas/50" aria-hidden="true"><path d="M6 0C3.79 0 2 1.79 2 4c0 3 4 8 4 8s4-5 4-8c0-2.21-1.79-4-4-4zm0 5.5C5.17 5.5 4.5 6.17 4.5 7s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5z"/></svg>
            <span>Pioneer House, Moi Avenue, Nairobi CBD, Kenya</span>
          </p>
        </div>
      </div>
      <div>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-gray-400 mb-5">Services</p>
        <ul class="space-y-3" role="list">
          {footerSections.services.map((link) => (
            <li>
              <a href={link.href} class="inline-block py-1 text-[0.85rem] text-gray-300 hover:text-canvas transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-gray-400 mb-5">Tools</p>
        <ul class="space-y-3" role="list">
          {footerSections.tools.map((link) => (
            <li>
              <a href={link.href} class="inline-block py-1 text-[0.85rem] text-gray-300 hover:text-canvas transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-gray-400 mb-5">Help & Resources</p>
        <ul class="space-y-3" role="list">
          {footerSections.help.map((link) => (
            <li>
              <a href={link.href} class="inline-block py-1 text-[0.85rem] text-gray-300 hover:text-canvas transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-gray-400 mb-5">Data & Tools for Pros</p>
        <ul class="space-y-3" role="list">
          {footerSections.data.map((link) => (
            <li>
              <a href={link.href} class="inline-block py-1 text-[0.85rem] text-gray-300 hover:text-canvas transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-gray-400 mb-5">Company</p>
        <ul class="space-y-3" role="list">
          {footerSections.company.map((link) => (
            <li>
              <a href={link.href} class="inline-block py-1 text-[0.85rem] text-gray-300 hover:text-canvas transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mt-14 pt-6 border-t border-canvas/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p class="text-[0.75rem] text-gray-400">&copy; {year} Smart VAT Kenya. All rights reserved. · <a href="/privacy-policy/" class="underline underline-offset-2 hover:text-gray-300 transition-colors">Privacy Policy</a></p>
      <p class="text-[0.75rem] text-gray-400">
        VAT information based on{" "}
        <a href="/sources/" class="underline underline-offset-2 hover:text-gray-300 transition-colors">primary sources</a> · <a href="/rss.xml" class="underline underline-offset-2 hover:text-gray-300 transition-colors">RSS</a> · <a href="https://www.kra.go.ke" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-gray-300 transition-colors">KRA guidelines</a>
        . Official portal:{" "}
        <a href="https://itax.kra.go.ke" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-gray-300 transition-colors">itax.kra.go.ke</a>
      </p>
    </div>
  </div>
</footer>
