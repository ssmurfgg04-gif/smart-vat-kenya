# Netlify redirects - only explicit non-directory pages
# Netlify natively handles trailing slash normalization for directory-based static files
# (Astro outputs /resources/foo/index.html -> served at /resources/foo/)
# These explicit rules are only for pages that are NOT directory-based

# Blog (may be single page, not directory)
/blog  /blog/  301!

# Explicit non-directory pages
/forms  /forms/  301!
/partners  /partners/  301!
/privacy-policy  /privacy-policy/  301!

# Note: /about, /how-it-works, /tax-amnesty-2026 are directory-based in Astro output (trailingSlash: "always")
# Netlify natively handles /foo -> /foo/ for directory-based content

# 301 (2026-09-10): retired stale August 2026 single-month deadline page -> evergreen calendar.
/resources/kra-vat-filing-deadline-august-2026  /tax-deadlines/  301!
/resources/kra-vat-filing-deadline-august-2026/ /tax-deadlines/  301!
