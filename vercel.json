{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/resources/kra-vat-filing-deadline-august-2026",
      "destination": "/tax-deadlines/",
      "permanent": true
    },
    {
      "source": "/resources/kra-vat-filing-deadline-august-2026/",
      "destination": "/tax-deadlines/",
      "permanent": true
    },
    {
      "source": "/resources/vat-registration-kenya-compare-options",
      "destination": "/resources/vat-registration-options-kenya/",
      "permanent": true
    },
    {
      "source": "/resources/vat-registration-kenya-compare-options/",
      "destination": "/resources/vat-registration-options-kenya/",
      "permanent": true
    },
    {
      "source": "/resources/etims-vs-kra-shuru-chatbot",
      "destination": "/resources/etims-vs-shuru-comparison/",
      "permanent": true
    },
    {
      "source": "/resources/etims-vs-kra-shuru-chatbot/",
      "destination": "/resources/etims-vs-shuru-comparison/",
      "permanent": true
    },
    {
      "source": "/resources/real-cost-of-taxes-kenyan-sme",
      "destination": "/resources/real-tax-bill-kenyan-sme/",
      "permanent": true
    },
    {
      "source": "/resources/real-cost-of-taxes-kenyan-sme/",
      "destination": "/resources/real-tax-bill-kenyan-sme/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
